<snippet>
<content><![CDATA[
resource "aws_glue_data_catalog_encryption_settings" "${1:name}" {
  data_catalog_encryption_settings {
    connection_password_encryption {
      return_connection_password_encrypted = ${2:false}
    }
    encryption_at_rest {
      catalog_encryption_mode = "${3:catalog_encryption_mode}"
    }
  }

  # catalog_id = ""  # ID of the Data Catalog to set the security configuration for.
  # region     = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_glue_data_catalog_encryption_settings</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a Glue Data Catalog Encryption Settings resource.</description>
</snippet>
