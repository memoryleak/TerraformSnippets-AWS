<content><![CDATA[
resource "aws_eks_identity_provider_config" "${1:name}" {
  cluster_name = "${2:cluster_name}"  # Name of the EKS Cluster.
  oidc {
    client_id                     = "${3:client_id}"
    identity_provider_config_name = "${4:identity_provider_config_name}"
    issuer_url                    = "${5:issuer_url}"
  }

  # region = ""  # Region where this resource will be managed.
  # tags   = {}  # Key-value map of resource tags.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_eks_identity_provider_config</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an EKS Identity Provider Configuration.</description>
</snippet>
