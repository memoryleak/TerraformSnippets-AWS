<snippet>
<content><![CDATA[
resource "aws_lightsail_disk_attachment" "${1:name}" {
  disk_name     = "${2:disk_name}"      # Name of the Lightsail disk.
  disk_path     = "${3:disk_path}"      # Disk path to expose to the instance.
  instance_name = "${4:instance_name}"  # Name of the Lightsail instance to attach to.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_lightsail_disk_attachment</tabTrigger>
<scope>source.terraform</scope>
<description>Manages the attachment of a Lightsail disk to an instance.</description>
</snippet>
