<content><![CDATA[
resource "aws_sagemaker_code_repository" "${1:name}" {
  code_repository_name = "${2:code_repository_name}"  # The name of the Code Repository (must be unique).
  git_config {
    repository_url = "${3:repository_url}"
  }

  # region = ""  # Region where this resource will be managed.
  # tags   = {}  # A map of tags to assign to the resource.
}
]]></content>
<tabTrigger>aws_sagemaker_code_repository</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a SageMaker AI Code Repository resource.</description>
</snippet>
