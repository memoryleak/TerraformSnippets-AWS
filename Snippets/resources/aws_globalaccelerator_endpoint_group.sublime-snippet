resource "aws_globalaccelerator_endpoint_group" "${1:name}" {
  listener_arn = "${2:listener_arn}"  # ARN of the listener.

  # endpoint_group_region         = ""  # AWS Region where the endpoint group is located.
  # health_check_interval_seconds = 0   # Time—10 seconds or 30 seconds—between each health check for an endpoint.
  # health_check_path             = ""  # If the protocol is HTTP/S, then this specifies the path that is the destination for health check...
  # health_check_port             = 0   # Port that AWS Global Accelerator uses to check the health of endpoints that are part of this endp...
  # health_check_protocol         = ""  # Protocol that AWS Global Accelerator uses to check the health of endpoints that are part of this...
  # threshold_count               = 0   # Number of consecutive health checks required to set the state of a healthy endpoint to unhealthy,...
  # traffic_dial_percentage       = 0   # Percentage of traffic to send to an AWS Region.
  # endpoint_configuration {}  # Endpoint objects.
  # port_override {}  # Override specific listener ports used to route traffic to endpoints that are part of this endpoin...
  # timeouts {}
}
]]></content>
