<content><![CDATA[
resource "aws_datapipeline_pipeline_definition" "${1:name}" {
  pipeline_id = "${2:pipeline_id}"  # ID of the pipeline.
  pipeline_object {
    name = "${3:name}"
  }

  # region = ""  # Region where this resource will be managed.
  # parameter_object {}  # Configuration block for the parameter objects used in the pipeline definition.
  # parameter_value {}  # Configuration block for the parameter values used in the pipeline definition.
}
]]></content>
