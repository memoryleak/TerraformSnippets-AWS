<content><![CDATA[
resource "aws_kinesis_video_stream" "${1:name}" {
  name = "${2:name}"  # Name to identify the stream.

  # data_retention_in_hours = 0   # Number of hours that you want to retain the data in the stream.
  # device_name             = ""  # Name of the device that is writing to the stream.
  # kms_key_id              = ""  # ID of the KMS key that you want Kinesis Video Streams to use to encrypt stream data.
  # media_type              = ""  # Media type of the stream.
  # region                  = ""  # Region where this resource will be managed.
  # tags                    = {}  # Map of tags to assign to the resource.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_kinesis_video_stream</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a AWS Kinesis Video Stream</description>
</snippet>
