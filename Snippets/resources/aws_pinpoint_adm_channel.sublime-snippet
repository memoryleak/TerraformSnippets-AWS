<content><![CDATA[
resource "aws_pinpoint_adm_channel" "${1:name}" {
  application_id = "${2:application_id}"  # Application ID.
  client_id      = "${3:client_id}"       # Client ID (part of OAuth Credentials) obtained via Amazon Developer Account.
  client_secret  = "${4:client_secret}"   # Client Secret (part of OAuth Credentials) obtained via Amazon Developer Account.

  # enabled = false  # Whether to enable the channel.
  # region  = ""     # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_pinpoint_adm_channel</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an End User Messaging ADM Channel resource.</description>
