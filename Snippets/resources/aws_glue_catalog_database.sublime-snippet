<content><![CDATA[
resource "aws_glue_catalog_database" "${1:name}" {
  name = "${2:name}"  # Name of the database.

  # catalog_id   = ""  # ID of the Glue Catalog to create the database in.
  # description  = ""  # Description of the database.
  # location_uri = ""  # Location of the database (for example, an HDFS path).
  # parameters   = {}  # List of key-value pairs that define parameters and properties of the database.
  # region       = ""  # Region where this resource will be managed.
  # tags         = {}  # Key-value map of resource tags.
  # create_table_default_permission {}  # Creates a set of default permissions on the table for principals.
  # federated_database {}  # Configuration block that references an entity outside the AWS Glue Data Catalog.
  # target_database {}  # Configuration block for a target database for resource linking.
}
]]></content>
<tabTrigger>aws_glue_catalog_database</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a Glue Catalog Database.</description>
</snippet>
