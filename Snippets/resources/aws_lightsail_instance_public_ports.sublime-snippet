<snippet>
<content><![CDATA[
resource "aws_lightsail_instance_public_ports" "${1:name}" {
  instance_name = "${2:instance_name}"  # Name of the instance for which to open ports.
  port_info {
    from_port = ${3:0}
    protocol  = "${4:protocol}"
    to_port   = ${5:0}
  }

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_lightsail_instance_public_ports</tabTrigger>
<scope>source.terraform</scope>
<description>Manages public ports for a Lightsail instance.</description>
</snippet>
