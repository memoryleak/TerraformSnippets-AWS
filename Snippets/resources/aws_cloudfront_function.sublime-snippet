<snippet>
<content><![CDATA[
resource "aws_cloudfront_function" "${1:name}" {
  code    = "${2:code}"     # Source code of the function.
  name    = "${3:name}"     # Unique name for your CloudFront Function.
  runtime = "${4:runtime}"  # Identifier of the function's runtime.

  # comment                      = ""     # Comment.
  # key_value_store_associations = []     # List of aws_cloudfront_key_value_store ARNs to be associated to the function.
  # publish                      = false  # Whether to publish creation/change as Live CloudFront Function Version.
  # tags                         = {}     # Map of tags to assign to the resource.
}
]]></content>
<tabTrigger>aws_cloudfront_function</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a CloudFront Function resource.</description>
</snippet>
