<snippet>
<content><![CDATA[
resource "aws_lex_bot" "${1:name}" {
  child_directed = ${2:false}   # By specifying true, you confirm that your use of Amazon Lex is related to a website, program, or...
  name           = "${3:name}"  # The name of the bot that you want to create, case sensitive.
  abort_statement {
    message {
      content      = "${4:content}"
      content_type = "${5:content_type}"
    }
  }
  intent {
    intent_name    = "${6:intent_name}"
    intent_version = "${7:intent_version}"
  }

  # create_version                  = false  # Determines if a new bot version is created when the initial resource is created and on each update.
  # description                     = ""     # A description of the bot.
  # detect_sentiment                = false  # When set to true user utterances are sent to Amazon Comprehend for sentiment analysis.
  # enable_model_improvements       = false  # Set to true to enable access to natural language understanding improvements.
  # idle_session_ttl_in_seconds     = 0      # The maximum time in seconds that Amazon Lex retains the data gathered in a conversation.
  # locale                          = ""     # Specifies the target locale for the bot.
  # nlu_intent_confidence_threshold = 0      # Determines the threshold where Amazon Lex will insert the AMAZON.FallbackIntent, AMAZON.KendraSea...
  # process_behavior                = ""     # If you set the process_behavior element to BUILD, Amazon Lex builds the bot so that it can be run.
  # region                          = ""     # Region where this resource will be managed.
  # voice_id                        = ""     # The Amazon Polly voice ID that you want Amazon Lex to use for voice interactions with the user.
  # clarification_prompt {}  # The message that Amazon Lex uses when it doesn't understand the user's request.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_lex_bot</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an Amazon Lex bot resource.</description>
</snippet>
