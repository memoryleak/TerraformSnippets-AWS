<content><![CDATA[
resource "aws_ssm_patch_baseline" "${1:name}" {
  name = "${2:name}"  # Name of the patch baseline.

  # approved_patches                             = []     # List of explicitly approved patches for the baseline.
  # approved_patches_compliance_level            = ""     # Compliance level for approved patches.
  # approved_patches_enable_non_security         = false  # Whether the list of approved patches includes non-security updates that should be applied to the...
  # available_security_updates_compliance_status = ""     # Indicates the compliance status of managed nodes for which security-related patches are available...
  # description                                  = ""     # Description of the patch baseline.
  # operating_system                             = ""     # Operating system the patch baseline applies to.
  # region                                       = ""     # Region where this resource will be managed.
  # rejected_patches                             = []     # List of rejected patches.
  # rejected_patches_action                      = ""     # Action for Patch Manager to take on patches included in the rejected_patches list.
  # tags                                         = {}     # Map of tags to assign to the resource.
  # approval_rule {}  # Set of rules used to include patches in the baseline.
  # global_filter {}  # Set of global filters used to exclude patches from the baseline.
  # source {}  # Configuration block with alternate sources for patches.
}
]]></content>
<tabTrigger>aws_ssm_patch_baseline</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an SSM Patch Baseline resource</description>
