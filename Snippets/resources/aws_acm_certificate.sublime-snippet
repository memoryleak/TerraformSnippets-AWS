  # private_key_wo            = ""  # Certificate's PEM-formatted private key.
  # private_key_wo_version    = 0   # Required when private_key_wo is set.
  # region                    = ""  # Region where this resource will be managed.
  # subject_alternative_names = []  # Set of domains that should be SANs in the issued certificate.
  # tags                      = {}  # Map of tags to assign to the resource.
  # validation_method         = ""  # Which method to use for validation.
  # options {}  # Configuration block used to set certificate options.
  # validation_option {}  # Configuration block used to specify information about the initial validation of each domain name.
}
]]></content>
