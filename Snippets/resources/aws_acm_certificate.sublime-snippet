resource "aws_acm_certificate" "${1:name}" {
  # certificate_authority_arn = ""  # ARN of an ACM PCA
  # certificate_body          = ""  # Certificate's PEM-formatted public key
  # certificate_chain         = ""  # Certificate's PEM-formatted chain
  # domain_name               = ""  # Domain name for which the certificate should be issued
  # early_renewal_duration    = ""  # Amount of time to start automatic renewal process before expiration.
  # key_algorithm             = ""  # Specifies the algorithm of the public and private key pair that your Amazon issued certificate us...
