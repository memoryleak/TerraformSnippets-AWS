<snippet>
<content><![CDATA[
resource "aws_iot_ca_certificate" "${1:name}" {
  active                  = ${2:false}                 # Boolean flag to indicate if the certificate should be active for device authentication.
  allow_auto_registration = ${3:false}                 # Boolean flag to indicate if the certificate should be active for device registration.
  ca_certificate_pem      = "${4:ca_certificate_pem}"  # PEM encoded CA certificate.

  # certificate_mode             = ""  # The certificate mode in which the CA will be registered.
  # region                       = ""  # Region where this resource will be managed.
  # tags                         = {}  # A map of tags to assign to the resource.
  # verification_certificate_pem = ""  # PEM encoded verification certificate containing the common name of a registration code.
  # registration_config {}  # Information about the registration configuration.
}
]]></content>
<tabTrigger>aws_iot_ca_certificate</tabTrigger>
<scope>source.terraform</scope>
<description>Creates and manages an AWS IoT CA Certificate.</description>
</snippet>
