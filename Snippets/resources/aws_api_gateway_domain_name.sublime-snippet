  # certificate_private_key                = ""  # Private key associated with the domain certificate given in certificate_body.
  # endpoint_access_mode                   = ""  # Endpoint access mode of the DomainName.
  # ownership_verification_certificate_arn = ""  # ARN of the AWS-issued certificate used to validate custom domain ownership (when certificate_arn...
  # policy                                 = ""  # Stringified JSON policy document that applies to the execute-api service for this DomainName rega...
  # region                                 = ""  # Region where this resource will be managed.
  # regional_certificate_arn               = ""  # ARN for an AWS-managed certificate.
  # regional_certificate_name              = ""  # User-friendly name of the certificate that will be used by regional endpoint for this domain name.
  # routing_mode                           = ""  # Mode to route traffic for the domain name.
  # security_policy                        = ""  # TLS version + cipher suite for this DomainName.
  # tags                                   = {}  # Key-value map of resource tags.
  # endpoint_configuration {}  # Configuration block defining API endpoint information including type.
  # mutual_tls_authentication {}  # Mutual TLS authentication configuration for the domain name.
  # timeouts {}
}
]]></content>
