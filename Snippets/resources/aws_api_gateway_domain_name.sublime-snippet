resource "aws_api_gateway_domain_name" "${1:name}" {
  domain_name = "${2:domain_name}"  # Fully-qualified domain name to register.

  # certificate_arn                        = ""  # ARN for an AWS-managed certificate.
  # certificate_body                       = ""  # Certificate issued for the domain name being registered, in PEM format.
