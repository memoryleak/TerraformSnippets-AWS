resource "aws_ses_identity_policy" "${1:name}" {
  identity = "${2:identity}"  # Name or ARN of the SES Identity.
  name     = "${3:name}"      # Name of the policy.
  policy   = "${4:policy}"    # JSON string of the policy.

  # region = ""  # Region where this resource will be managed.
}
