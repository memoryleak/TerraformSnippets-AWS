resource "aws_s3tables_table_bucket_policy" "${1:name}" {
  resource_policy  = "${2:resource_policy}"   # Amazon Web Services resource-based policy document in JSON format.
  table_bucket_arn = "${3:table_bucket_arn}"  # ARN referencing the Table Bucket that owns this policy.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
