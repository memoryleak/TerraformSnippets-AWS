<snippet>
<content><![CDATA[
resource "aws_chime_voice_connector_termination_credentials" "${1:name}" {
  voice_connector_id = "${2:voice_connector_id}"  # Amazon Chime Voice Connector ID.
  credentials {
    password = "${3:password}"
    username = "${4:username}"
  }

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_chime_voice_connector_termination_credentials</tabTrigger>
<scope>source.terraform</scope>
<description>Adds termination SIP credentials for the specified Amazon Chime Voice Connector.</description>
</snippet>
