<content><![CDATA[
resource "aws_docdb_event_subscription" "${1:name}" {
  sns_topic_arn = "${2:sns_topic_arn}"

  # enabled          = false  # A boolean flag to enable/disable the subscription.
  # event_categories = []     # A list of event categories for a SourceType that you want to subscribe to.
  # name             = ""     # The name of the DocumentDB event subscription.
  # name_prefix      = ""     # The name of the DocumentDB event subscription.
  # region           = ""     # Region where this resource will be managed.
  # source_ids       = []     # A list of identifiers of the event sources for which events will be returned.
  # source_type      = ""     # The type of source that will be generating the events.
  # tags             = {}     # A map of tags to assign to the resource.
  # timeouts {}
}
]]></content>
