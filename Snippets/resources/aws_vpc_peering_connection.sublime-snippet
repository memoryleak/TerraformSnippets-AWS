<content><![CDATA[
resource "aws_vpc_peering_connection" "${1:name}" {
  peer_vpc_id = "${2:peer_vpc_id}"  # ID of the target VPC with which you are creating the VPC Peering Connection.
  vpc_id      = "${3:vpc_id}"       # ID of the requester VPC.

  # auto_accept   = false  # Whether to accept the peering (both VPCs need to be in the same AWS account and region).
  # peer_owner_id = ""     # AWS account ID of the target peer VPC.
  # peer_region   = ""     # Region of the accepter VPC of the VPC Peering Connection.
  # region        = ""     # Region where this resource will be managed.
  # tags          = {}     # Map of tags to assign to the resource.
  # accepter {}  # Configuration block for VPC Peering Connection options to set for the VPC that accepts the peerin...
  # requester {}  # Configuration block for VPC Peering Connection options to set for the VPC that requests the peeri...
  # timeouts {}
}
]]></content>
<tabTrigger>aws_vpc_peering_connection</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a resource to manage a VPC peering connection.</description>
