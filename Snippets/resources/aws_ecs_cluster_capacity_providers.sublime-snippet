resource "aws_ecs_cluster_capacity_providers" "${1:name}" {
  cluster_name = "${2:cluster_name}"  # Name of the ECS cluster to manage capacity providers for.

  # capacity_providers = []  # Set of names of one or more capacity providers to associate with the cluster.
