resource "aws_cloudwatch_event_archive" "${1:name}" {
  event_source_arn = "${2:event_source_arn}"  # ARN of the event bus associated with the archive.
  name             = "${3:name}"              # Name of the archive.

  # description        = ""  # Description for the archive.
  # event_pattern      = ""  # Event pattern to use to filter events sent to the archive.
