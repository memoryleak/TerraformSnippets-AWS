resource "aws_backup_vault_policy" "${1:name}" {
  backup_vault_name = "${2:backup_vault_name}"  # Name of the backup vault to add policy for.
  policy            = "${3:policy}"             # Backup vault access policy document in JSON format.

  # region = ""  # Region where this resource will be managed.
}
