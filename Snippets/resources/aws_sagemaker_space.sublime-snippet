<content><![CDATA[
resource "aws_sagemaker_space" "${1:name}" {
  domain_id  = "${2:domain_id}"   # The ID of the associated Domain.
  space_name = "${3:space_name}"  # The name of the space.

  # region             = ""  # Region where this resource will be managed.
  # space_display_name = ""  # The name of the space that appears in the SageMaker AI Studio UI.
  # tags               = {}  # A map of tags to assign to the resource.
  # ownership_settings {}  # A collection of ownership settings.
  # space_settings {}  # A collection of space settings.
  # space_sharing_settings {}  # A collection of space sharing settings.
}
]]></content>
<tabTrigger>aws_sagemaker_space</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a SageMaker AI Space resource.</description>
