  # disable_execute_api_endpoint = false  # Whether clients can invoke the API by using the default execute-api endpoint.
  # fail_on_warnings             = false  # Whether warnings should return an error while API Gateway is creating or updating the resource us...
  # ip_address_type              = ""     # IP address types that can invoke the API.
  # region                       = ""     # Region where this resource will be managed.
  # route_key                    = ""     # Part of _quick create_.
  # route_selection_expression   = ""     # Route selection expression for the API.
  # tags                         = {}     # Map of tags to assign to the API.
  # target                       = ""     # Part of _quick create_.
  # version                      = ""     # Version identifier for the API.
  # cors_configuration {}  # Cross-origin resource sharing (CORS) configuration.
}
