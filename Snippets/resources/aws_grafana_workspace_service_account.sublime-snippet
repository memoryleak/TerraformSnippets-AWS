<snippet>
<content><![CDATA[
resource "aws_grafana_workspace_service_account" "${1:name}" {
  grafana_role = "${2:grafana_role}"  # Permission level to use for this service account.
  name         = "${3:name}"          # Name for the service account.
  workspace_id = "${4:workspace_id}"  # Grafana workspace with which the service account is associated.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_grafana_workspace_service_account</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an Amazon Managed Grafana Workspace Service Account.</description>
</snippet>
