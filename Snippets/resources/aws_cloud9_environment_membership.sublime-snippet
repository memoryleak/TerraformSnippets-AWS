<snippet>
<content><![CDATA[
resource "aws_cloud9_environment_membership" "${1:name}" {
  environment_id = "${2:environment_id}"  # The ID of the environment that contains the environment member you want to add.
  permissions    = "${3:permissions}"     # The type of environment member permissions you want to associate with this environment member.
  user_arn       = "${4:user_arn}"        # ARN of the environment member you want to add.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_cloud9_environment_membership</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an environment member to an AWS Cloud9 development environment.</description>
</snippet>
