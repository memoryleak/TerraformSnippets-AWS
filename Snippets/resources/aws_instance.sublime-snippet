  # maintenance_options {}  # Maintenance and recovery options for the instance.
  # metadata_options {}  # Customize the metadata options of the instance.
  # primary_network_interface {}  # The primary network interface.
  # private_dns_name_options {}  # Options for the instance hostname.
  # root_block_device {}  # Configuration block to customize details about the root block device of the instance.
