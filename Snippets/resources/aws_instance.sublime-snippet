  # source_dest_check                    = false  # Controls if traffic is routed to the instance when the destination address does not match the ins...
  # subnet_id                            = ""     # VPC Subnet ID to launch in.
  # tags                                 = {}     # Map of tags to assign to the resource.
  # tenancy                              = ""     # Tenancy of the instance (if the instance is running in a VPC).
  # user_data                            = ""     # User data to provide when launching the instance.
