  # cpu_options {}  # The CPU options for the instance.
  # credit_specification {}  # Configuration block for customizing the credit specification of the instance.
  # ebs_block_device {}  # One or more configuration blocks with additional EBS block devices to attach to the instance.
  # enclave_options {}  # Enable Nitro Enclaves on launched instances.
