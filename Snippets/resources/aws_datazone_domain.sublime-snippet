<snippet>
<content><![CDATA[
resource "aws_datazone_domain" "${1:name}" {
  domain_execution_role = "${2:domain_execution_role}"  # ARN of the role used by DataZone to configure the Domain.
  name                  = "${3:name}"                   # Name of the Domain.

  # description         = ""     # Description of the Domain.
  # domain_version      = ""     # Version of the Domain.
  # kms_key_identifier  = ""     # ARN of the KMS key used to encrypt the Amazon DataZone domain, metadata and reporting data.
  # region              = ""     # Region where this resource will be managed.
  # service_role        = ""     # ARN of the service role used by DataZone.
  # skip_deletion_check = false  # Whether to skip the deletion check for the Domain.
  # tags                = {}
  # single_sign_on {}  # Single sign on options, used to enable AWS IAM Identity Center for DataZone.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_datazone_domain</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS DataZone Domain.</description>
</snippet>
