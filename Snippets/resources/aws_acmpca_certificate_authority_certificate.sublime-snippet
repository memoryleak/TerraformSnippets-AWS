<snippet>
<content><![CDATA[
resource "aws_acmpca_certificate_authority_certificate" "${1:name}" {
  certificate               = "${2:certificate}"                # PEM-encoded certificate for the Certificate Authority.
  certificate_authority_arn = "${3:certificate_authority_arn}"  # ARN of the Certificate Authority.

  # certificate_chain = ""  # PEM-encoded certificate chain that includes any intermediate certificates and chains up to root CA.
  # region            = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_acmpca_certificate_authority_certificate</tabTrigger>
<scope>source.terraform</scope>
<description>Associates a certificate with an AWS Certificate Manager Private Certificate Authority</description>
</snippet>
