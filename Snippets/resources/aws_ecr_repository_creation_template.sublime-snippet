<content><![CDATA[
resource "aws_ecr_repository_creation_template" "${1:name}" {
  applied_for = [${2}]         # Which features this template applies to.
  prefix      = "${3:prefix}"  # The repository name prefix to match against.

  # custom_role_arn      = ""  # A custom IAM role to use for repository creation.
  # description          = ""  # The description for this template.
  # image_tag_mutability = ""  # The tag mutability setting for any created repositories.
  # lifecycle_policy     = ""  # The lifecycle policy document to apply to any created repositories.
  # region               = ""  # Region where this resource will be managed.
  # repository_policy    = ""  # The registry policy document to apply to any created repositories.
  # resource_tags        = {}  # A map of tags to assign to any created repositories.
  # encryption_configuration {}  # Encryption configuration for any created repositories.
  # image_tag_mutability_exclusion_filter {}  # Configuration block that defines filters to specify which image tags can override the default tag...
}
]]></content>
<tabTrigger>aws_ecr_repository_creation_template</tabTrigger>
