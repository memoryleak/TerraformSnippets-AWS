<content><![CDATA[
resource "aws_cloudwatch_event_target" "${1:name}" {
  arn  = "${2:arn}"   # ARN of the target.
  rule = "${3:rule}"  # The name of the rule you want to add targets to.

  # event_bus_name = ""     # The name or ARN of the event bus to associate with the rule.
  # force_destroy  = false  # Used to delete managed rules created by AWS.
  # input          = ""     # Valid JSON text passed to the target.
  # input_path     = ""     # The value of the JSONPath that is used for extracting part of the matched event when passing it t...
  # region         = ""     # Region where this resource will be managed.
  # role_arn       = ""     # ARN of the IAM role to be used for this target when the rule is triggered.
  # target_id      = ""     # The unique target assignment ID.
  # appsync_target {}  # Parameters used when you are using the rule to invoke an AppSync GraphQL API mutation.
  # batch_target {}  # Parameters used when you are using the rule to invoke an Amazon Batch Job.
  # dead_letter_config {}  # Parameters used when you are providing a dead letter config.
  # ecs_target {}  # Parameters used when you are using the rule to invoke Amazon ECS Task.
  # http_target {}  # Parameters used when you are using the rule to invoke an API Gateway REST endpoint.
  # input_transformer {}  # Parameters used when you are providing a custom input to a target based on certain event data.
  # kinesis_target {}  # Parameters used when you are using the rule to invoke an Amazon Kinesis Stream.
  # redshift_target {}  # Parameters used when you are using the rule to invoke an Amazon Redshift Statement.
  # retry_policy {}  # Parameters used when you are providing retry policies.
  # run_command_targets {}  # Parameters used when you are using the rule to invoke Amazon EC2 Run Command.
  # sagemaker_pipeline_target {}  # Parameters used when you are using the rule to invoke an Amazon SageMaker AI Pipeline.
  # sqs_target {}  # Parameters used when you are using the rule to invoke an Amazon SQS Queue.
}
]]></content>
<tabTrigger>aws_cloudwatch_event_target</tabTrigger>
