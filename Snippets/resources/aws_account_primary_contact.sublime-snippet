<snippet>
<content><![CDATA[
resource "aws_account_primary_contact" "${1:name}" {
  address_line_1 = "${2:address_line_1}"  # The first line of the primary contact address.
  city           = "${3:city}"            # The city of the primary contact address.
  country_code   = "${4:country_code}"    # The ISO-3166 two-letter country code for the primary contact address.
  full_name      = "${5:full_name}"       # The full name of the primary contact address.
  phone_number   = "${6:phone_number}"    # The phone number of the primary contact information.
  postal_code    = "${7:postal_code}"     # The postal code of the primary contact address.

  # account_id         = ""  # The ID of the target account when managing member accounts.
  # address_line_2     = ""  # The second line of the primary contact address, if any.
  # address_line_3     = ""  # The third line of the primary contact address, if any.
  # company_name       = ""  # The name of the company associated with the primary contact information, if any.
  # district_or_county = ""  # The district or county of the primary contact address, if any.
  # state_or_region    = ""  # The state or region of the primary contact address.
  # website_url        = ""  # The URL of the website associated with the primary contact information, if any.
}
]]></content>
<tabTrigger>aws_account_primary_contact</tabTrigger>
<scope>source.terraform</scope>
<description>Manages the specified primary contact information associated with an AWS Account.</description>
</snippet>
