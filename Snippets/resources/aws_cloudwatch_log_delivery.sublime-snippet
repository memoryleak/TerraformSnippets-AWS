<snippet>
<content><![CDATA[
resource "aws_cloudwatch_log_delivery" "${1:name}" {
  delivery_destination_arn = "${2:delivery_destination_arn}"  # The ARN of the delivery destination to use for this delivery.
  delivery_source_name     = "${3:delivery_source_name}"      # The name of the delivery source to use for this delivery.

  # field_delimiter           = ""  # The field delimiter to use between record fields when the final output format of a delivery is in...
  # record_fields             = []  # The list of record fields to be delivered to the destination, in order.
  # region                    = ""  # Region where this resource will be managed.
  # s3_delivery_configuration = []  # Parameters that are valid only when the delivery's delivery destination is an S3 bucket.
  # tags                      = {}  # A map of tags to assign to the resource.
}
]]></content>
<tabTrigger>aws_cloudwatch_log_delivery</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS CloudWatch Logs Delivery.</description>
</snippet>
