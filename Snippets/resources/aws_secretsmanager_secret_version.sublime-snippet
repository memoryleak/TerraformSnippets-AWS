<content><![CDATA[
resource "aws_secretsmanager_secret_version" "${1:name}" {
  secret_id = "${2:secret_id}"  # Secret to which you want to add a new version.

  # region                   = ""  # Region where this resource will be managed.
  # secret_binary            = ""  # Binary data that you want to encrypt and store in this version of the secret.
  # secret_string            = ""  # Text data that you want to encrypt and store in this version of the secret.
  # secret_string_wo         = ""  # Text data that you want to encrypt and store in this version of the secret.
  # secret_string_wo_version = 0   # Required when secret_string_wo is set.
  # version_stages           = []  # List of staging labels that are attached to this version of the secret.
}
]]></content>
<tabTrigger>aws_secretsmanager_secret_version</tabTrigger>
