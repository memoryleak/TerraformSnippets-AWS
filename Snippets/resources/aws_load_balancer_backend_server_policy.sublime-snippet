<snippet>
<content><![CDATA[
resource "aws_load_balancer_backend_server_policy" "${1:name}" {
  instance_port      = ${2:0}                     # The instance port to apply the policy to.
  load_balancer_name = "${3:load_balancer_name}"  # The load balancer to attach the policy to.

  # policy_names = []  # List of Policy Names to apply to the backend server.
  # region       = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_load_balancer_backend_server_policy</tabTrigger>
<scope>source.terraform</scope>
<description>Attaches a load balancer policy to an ELB backend server.</description>
</snippet>
