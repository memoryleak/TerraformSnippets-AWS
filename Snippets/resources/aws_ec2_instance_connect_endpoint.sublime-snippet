<content><![CDATA[
resource "aws_ec2_instance_connect_endpoint" "${1:name}" {
  subnet_id = "${2:subnet_id}"  # The ID of the subnet in which to create the EC2 Instance Connect Endpoint.

  # ip_address_type    = ""     # IP address type of the endpoint.
  # preserve_client_ip = false  # Indicates whether your client's IP address is preserved as the source.
  # region             = ""     # Region where this resource will be managed.
  # security_group_ids = []     # One or more security groups to associate with the endpoint.
  # tags               = {}     # Map of tags to assign to this resource.
  # timeouts {}
}
]]></content>
