<snippet>
<content><![CDATA[
resource "aws_medialive_channel" "${1:name}" {
  channel_class = "${2:channel_class}"  # Class of the channel.
  name          = "${3:name}"           # Name of the channel.
  destinations {
  }
  encoder_settings {
    output_groups {
      output_group_settings {
      }
      outputs {
        output_settings {
        }
      }
    }
    timecode_config {
      source = "${4:source}"
    }
  }
  input_attachments {
    input_attachment_name = "${5:input_attachment_name}"
    input_id              = "${6:input_id}"
  }
  input_specification {
    codec            = "${7:codec}"
    input_resolution = "${8:input_resolution}"
    maximum_bitrate  = "${9:maximum_bitrate}"
  }

  # log_level     = ""     # Level of verbosity for the logs written to CloudWatch Logs.
  # region        = ""     # Region where this resource will be managed.
  # role_arn      = ""     # ARN of the IAM role for the channel.
  # start_channel = false  # Whether to start/stop channel.
  # tags          = {}     # Map of tags to assign to the channel.
  # cdi_input_specification {}  # Specification of CDI inputs for this channel.
  # maintenance {}  # Maintenance settings for this channel.
  # timeouts {}
  # vpc {}  # Settings for the VPC outputs.
}
]]></content>
<tabTrigger>aws_medialive_channel</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS MediaLive Channel.</description>
</snippet>
