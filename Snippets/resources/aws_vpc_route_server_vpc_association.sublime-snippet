<content><![CDATA[
resource "aws_vpc_route_server_vpc_association" "${1:name}" {
  route_server_id = "${2:route_server_id}"  # Unique identifier for the route server to be associated.
  vpc_id          = "${3:vpc_id}"           # ID of the VPC to associate with the route server.

  # region = ""  # Region where this resource will be managed.
  # timeouts {}
}
]]></content>
