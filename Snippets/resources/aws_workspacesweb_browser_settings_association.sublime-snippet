<content><![CDATA[
resource "aws_workspacesweb_browser_settings_association" "${1:name}" {
  browser_settings_arn = "${2:browser_settings_arn}"  # ARN of the browser settings to associate with the portal.
  portal_arn           = "${3:portal_arn}"            # ARN of the portal to associate with the browser settings.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_workspacesweb_browser_settings_association</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS WorkSpaces Web Browser Settings Association.</description>
