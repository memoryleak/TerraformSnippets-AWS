<content><![CDATA[
resource "aws_prometheus_alert_manager_definition" "${1:name}" {
  definition   = "${2:definition}"    # the alert manager definition that you want to be applied.
  workspace_id = "${3:workspace_id}"  # ID of the prometheus workspace the alert manager definition should be linked to

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_prometheus_alert_manager_definition</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an Amazon Managed Service for Prometheus (AMP) Alert Manager Definition</description>
