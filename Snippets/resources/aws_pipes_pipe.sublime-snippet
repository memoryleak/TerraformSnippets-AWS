<content><![CDATA[
resource "aws_pipes_pipe" "${1:name}" {
  role_arn = "${2:role_arn}"  # ARN of the role that allows the pipe to send data to the target.
  source   = "${3:source}"    # Source resource of the pipe.
  target   = "${4:target}"    # Target resource of the pipe (typically an ARN).

  # description        = ""  # Description of the pipe.
  # desired_state      = ""  # State the pipe should be in.
  # enrichment         = ""  # Enrichment resource of the pipe (typically an ARN).
  # kms_key_identifier = ""  # Identifier of the AWS KMS customer managed key for EventBridge to use, if you choose to use a cus...
  # name               = ""  # Name of the pipe.
  # name_prefix        = ""  # Creates a unique name beginning with the specified prefix.
  # region             = ""  # Region where this resource will be managed.
  # tags               = {}  # Map of tags assigned to the resource.
  # enrichment_parameters {}  # Parameters to configure enrichment for the pipe.
  # log_configuration {}  # Logging configuration settings for the pipe.
  # source_parameters {}  # Parameters to configure a source for the pipe.
  # target_parameters {}  # Parameters to configure a target for the pipe.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_pipes_pipe</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS EventBridge Pipes Pipe.</description>
