<content><![CDATA[
resource "aws_vpc_endpoint_route_table_association" "${1:name}" {
  route_table_id  = "${2:route_table_id}"   # Identifier of the EC2 Route Table to be associated with the VPC Endpoint.
  vpc_endpoint_id = "${3:vpc_endpoint_id}"  # Identifier of the VPC Endpoint with which the EC2 Route Table will be associated.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_vpc_endpoint_route_table_association</tabTrigger>
<scope>source.terraform</scope>
<description>Manages a VPC Endpoint Route Table Association</description>
