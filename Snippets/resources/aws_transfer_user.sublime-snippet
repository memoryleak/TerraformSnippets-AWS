<content><![CDATA[
resource "aws_transfer_user" "${1:name}" {
  role      = "${2:role}"       # ARN of an IAM role that allows the service to control your user’s access to your Amazon S3 bucket.
  server_id = "${3:server_id}"  # Server ID of the Transfer Server (e.g., s-12345678)
  user_name = "${4:user_name}"  # Name used for log in to your SFTP server.

  # home_directory      = ""  # Landing directory (folder) for a user when they log in to the server using their SFTP client.
  # home_directory_type = ""  # Type of landing directory (folder) you mapped for your users' home directory.
  # policy              = ""  # IAM JSON policy document that scopes down user access to portions of their Amazon S3 bucket.
  # region              = ""  # Region where this resource will be managed.
  # tags                = {}  # Map of tags to assign to the resource.
  # home_directory_mappings {}  # Logical directory mappings that specify what S3 paths and keys should be visible to your user and...
  # posix_profile {}  # Full POSIX identity, including user ID (Uid), group ID (Gid), and any secondary groups IDs (Secon...
  # timeouts {}
}
]]></content>
<tabTrigger>aws_transfer_user</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a AWS Transfer User resource.</description>
