<content><![CDATA[
resource "aws_lb_listener_rule" "${1:name}" {
  listener_arn = "${2:listener_arn}"  # The ARN of the listener to which to attach the rule.
  action {
    type = "${3:type}"
  }
  condition {
  }

  # priority = 0   # The priority for the rule between 1 and 50000.
  # region   = ""  # Region where this resource will be managed.
  # tags     = {}  # A map of tags to assign to the resource.
  # transform {}  # Configuration block that defines the transform to apply to requests matching this rule.
}
]]></content>
