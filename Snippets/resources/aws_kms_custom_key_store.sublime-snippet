<content><![CDATA[
resource "aws_kms_custom_key_store" "${1:name}" {
  custom_key_store_name = "${2:custom_key_store_name}"  # Unique name for Custom Key Store.

  # cloud_hsm_cluster_id                = ""  # Cluster ID of CloudHSM.
  # custom_key_store_type               = ""  # Type of key store to create.
  # key_store_password                  = ""  # Password for the kmsuser of an AWS CloudHSM key store.
  # region                              = ""  # Region where this resource will be managed.
  # trust_anchor_certificate            = ""  # Certificate for an AWS CloudHSM key store.
  # xks_proxy_connectivity              = ""  # How AWS KMS communicates with the external key store proxy.
  # xks_proxy_uri_endpoint              = ""  # Endpoint that AWS KMS uses to send requests to the external key store proxy (XKS proxy).
  # xks_proxy_uri_path                  = ""  # Base path to the proxy APIs for this external key store.
  # xks_proxy_vpc_endpoint_service_name = ""  # Name of the Amazon VPC endpoint service for interface endpoints that is used to communicate with...
  # timeouts {}
  # xks_proxy_authentication_credential {}  # Authentication credential for the external key store proxy (XKS proxy).
}
]]></content>
<tabTrigger>aws_kms_custom_key_store</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS KMS (Key Management) Custom Key Store.</description>
