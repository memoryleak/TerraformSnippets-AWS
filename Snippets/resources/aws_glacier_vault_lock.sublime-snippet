<snippet>
<content><![CDATA[
resource "aws_glacier_vault_lock" "${1:name}" {
  complete_lock = ${2:false}         # Boolean whether to permanently apply this Glacier Lock Policy.
  policy        = "${3:policy}"      # JSON string containing the IAM policy to apply as the Glacier Vault Lock policy.
  vault_name    = "${4:vault_name}"  # Name of the Glacier Vault.

  # ignore_deletion_error = false  # Allow Terraform to ignore the error returned when attempting to delete the Glacier Lock Policy.
  # region                = ""     # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_glacier_vault_lock</tabTrigger>
<scope>source.terraform</scope>
<description>Manages a Glacier Vault Lock.</description>
</snippet>
