<snippet>
<content><![CDATA[
resource "aws_transcribe_vocabulary_filter" "${1:name}" {
  language_code          = "${2:language_code}"           # Language code you selected for your vocabulary filter.
  vocabulary_filter_name = "${3:vocabulary_filter_name}"  # Name of the VocabularyFilter.

  # region                     = ""  # Region where this resource will be managed.
  # tags                       = {}  # Map of tags to assign to the VocabularyFilter.
  # vocabulary_filter_file_uri = ""  # Amazon S3 location (URI) of the text file that contains your custom VocabularyFilter.
  # words                      = []  # List of terms to include in the vocabulary.
}
]]></content>
<tabTrigger>aws_transcribe_vocabulary_filter</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS Transcribe VocabularyFilter.</description>
</snippet>
