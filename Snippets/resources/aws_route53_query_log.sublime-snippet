resource "aws_route53_query_log" "${1:name}" {
  cloudwatch_log_group_arn = "${2:cloudwatch_log_group_arn}"  # CloudWatch log group ARN to send query logs.
  zone_id                  = "${3:zone_id}"                   # Route53 hosted zone ID to enable query logs.
}
]]></content>
