<content><![CDATA[
resource "aws_emr_studio" "${1:name}" {
  auth_mode                   = "${2:auth_mode}"                    # Specifies whether the Studio authenticates users using IAM or Amazon Web Services SSO.
  default_s3_location         = "${3:default_s3_location}"          # The Amazon S3 location to back up Amazon EMR Studio Workspaces and notebook files.
  engine_security_group_id    = "${4:engine_security_group_id}"     # The ID of the Amazon EMR Studio Engine security group.
  name                        = "${5:name}"                         # A descriptive name for the Amazon EMR Studio.
  service_role                = "${6:service_role}"                 # The IAM role that the Amazon EMR Studio assumes.
  subnet_ids                  = [${7}]                              # A list of subnet IDs to associate with the Amazon EMR Studio.
  vpc_id                      = "${8:vpc_id}"                       # ID of the VPC to associate with the Studio.
  workspace_security_group_id = "${9:workspace_security_group_id}"  # The ID of the Amazon EMR Studio Workspace security group.

  # description                    = ""  # A detailed description of the Amazon EMR Studio.
  # encryption_key_arn             = ""  # The AWS KMS key identifier (ARN) used to encrypt Amazon EMR Studio workspace and notebook files w...
  # idp_auth_url                   = ""  # The authentication endpoint of your identity provider (IdP).
  # idp_relay_state_parameter_name = ""  # The name that your identity provider (IdP) uses for its RelayState parameter.
  # region                         = ""  # Region where this resource will be managed.
  # tags                           = {}  # list of tags to apply to the EMR Cluster.
  # user_role                      = ""  # - The IAM user role that users and groups assume when logged in to an Amazon EMR Studio.
}
]]></content>
<tabTrigger>aws_emr_studio</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an Elastic MapReduce Studio</description>
</snippet>
