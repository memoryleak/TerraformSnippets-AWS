<snippet>
<content><![CDATA[
resource "aws_iam_service_specific_credential" "${1:name}" {
  service_name = "${2:service_name}"  # The name of the AWS service that is to be associated with the credentials.
  user_name    = "${3:user_name}"     # The name of the IAM user that is to be associated with the credentials.

  # credential_age_days = 0   # The number of days until the service specific credential expires.
  # status              = ""  # The status to be assigned to the service-specific credential.
}
]]></content>
<tabTrigger>aws_iam_service_specific_credential</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an IAM Service Specific Credential.</description>
</snippet>
