<snippet>
<content><![CDATA[
resource "aws_workspacesweb_data_protection_settings_association" "${1:name}" {
  data_protection_settings_arn = "${2:data_protection_settings_arn}"  # ARN of the data protection settings to associate with the portal.
  portal_arn                   = "${3:portal_arn}"                    # ARN of the portal to associate with the data protection settings.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_workspacesweb_data_protection_settings_association</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS WorkSpaces Web Data Protection Settings Association.</description>
