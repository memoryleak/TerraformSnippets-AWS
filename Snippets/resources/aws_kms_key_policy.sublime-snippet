resource "aws_kms_key_policy" "${1:name}" {
  key_id = "${2:key_id}"  # ID of the KMS Key to attach the policy.
  policy = "${3:policy}"  # Valid policy JSON document.

  # bypass_policy_lockout_safety_check = false  # Whether to bypass the key policy lockout safety check.
