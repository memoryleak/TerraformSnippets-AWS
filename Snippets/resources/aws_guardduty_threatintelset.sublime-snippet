<content><![CDATA[
resource "aws_guardduty_threatintelset" "${1:name}" {
  activate    = ${2:false}          # Whether to start using the uploaded ThreatIntelSet.
  detector_id = "${3:detector_id}"  # Detector ID of the GuardDuty.
  format      = "${4:format}"       # Format of the file that contains the ThreatIntelSet.
  location    = "${5:location}"     # URI of the file that contains the ThreatIntelSet.
  name        = "${6:name}"         # Friendly name to identify the ThreatIntelSet.

  # region = ""  # Region where this resource will be managed.
  # tags   = {}  # Key-value map of resource tags.
}
]]></content>
<tabTrigger>aws_guardduty_threatintelset</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a resource to manage a GuardDuty ThreatIntelSet</description>
</snippet>
