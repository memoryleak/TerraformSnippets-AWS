<content><![CDATA[
resource "aws_iot_topic_rule" "${1:name}" {
  enabled     = ${2:false}          # Specifies whether the rule is enabled.
  name        = "${3:name}"         # The name of the rule.
  sql         = "${4:sql}"          # The SQL statement used to query the topic.
  sql_version = "${5:sql_version}"  # The version of the SQL rules engine to use when evaluating the rule.

  # description = ""  # The description of the rule.
  # region      = ""  # Region where this resource will be managed.
  # tags        = {}  # Key-value map of resource tags.
  # cloudwatch_alarm {}
  # cloudwatch_logs {}
  # cloudwatch_metric {}
  # dynamodb {}
  # dynamodbv2 {}
  # elasticsearch {}
  # error_action {}  # Configuration block with error action to be associated with the rule.
  # firehose {}
  # http {}
  # iot_analytics {}
  # iot_events {}
  # kafka {}
  # kinesis {}
  # lambda {}
  # republish {}
  # s3 {}
  # sns {}
  # sqs {}
  # step_functions {}
  # timestream {}
}
]]></content>
<tabTrigger>aws_iot_topic_rule</tabTrigger>
<scope>source.terraform</scope>
<description>Creates and manages an AWS IoT topic rule</description>
</snippet>
