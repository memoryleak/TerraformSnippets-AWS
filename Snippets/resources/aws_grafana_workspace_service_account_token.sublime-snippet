<snippet>
<content><![CDATA[
resource "aws_grafana_workspace_service_account_token" "${1:name}" {
  name               = "${2:name}"                # Name for the token to create.
  seconds_to_live    = ${3:0}                     # Sets how long the token will be valid, in seconds.
  service_account_id = "${4:service_account_id}"  # ID of the service account for which to create a token.
  workspace_id       = "${5:workspace_id}"        # Grafana workspace with which the service account token is associated.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_grafana_workspace_service_account_token</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an Amazon Managed Grafana Workspace Service Account Token.</description>
</snippet>
