<content><![CDATA[
resource "aws_redshiftserverless_endpoint_access" "${1:name}" {
  endpoint_name  = "${2:endpoint_name}"   # The name of the endpoint.
  subnet_ids     = [${3}]                 # An array of VPC subnet IDs to associate with the endpoint.
  workgroup_name = "${4:workgroup_name}"  # The name of the workgroup.

  # owner_account          = ""  # The owner Amazon Web Services account for the Amazon Redshift Serverless workgroup.
  # region                 = ""  # Region where this resource will be managed.
  # vpc_security_group_ids = []  # An array of security group IDs to associate with the workgroup.
}
]]></content>
<tabTrigger>aws_redshiftserverless_endpoint_access</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a Redshift Serverless Endpoint Access resource.</description>
</snippet>
