<snippet>
<content><![CDATA[
resource "aws_ssoadmin_managed_policy_attachment" "${1:name}" {
  instance_arn       = "${2:instance_arn}"        # ARN of the SSO Instance under which the operation will be executed.
  managed_policy_arn = "${3:managed_policy_arn}"  # IAM managed policy ARN to be attached to the Permission Set.
  permission_set_arn = "${4:permission_set_arn}"  # ARN of the Permission Set.

  # region = ""  # Region where this resource will be managed.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_ssoadmin_managed_policy_attachment</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an IAM managed policy for a Single Sign-On (SSO) Permission Set</description>
</snippet>
