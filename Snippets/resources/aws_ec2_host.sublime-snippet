<snippet>
<content><![CDATA[
resource "aws_ec2_host" "${1:name}" {
  availability_zone = "${2:availability_zone}"  # The Availability Zone in which to allocate the Dedicated Host.

  # asset_id        = ""  # The ID of the Outpost hardware asset on which to allocate the Dedicated Hosts.
  # auto_placement  = ""  # Indicates whether the host accepts any untargeted instance launches that match its instance type...
  # host_recovery   = ""  # Indicates whether to enable or disable host recovery for the Dedicated Host.
  # instance_family = ""  # Specifies the instance family to be supported by the Dedicated Hosts.
  # instance_type   = ""  # Specifies the instance type to be supported by the Dedicated Hosts.
  # outpost_arn     = ""  # ARN of the AWS Outpost on which to allocate the Dedicated Host.
  # region          = ""  # Region where this resource will be managed.
  # tags            = {}  # Map of tags to assign to this resource.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_ec2_host</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an EC2 Host resource.</description>
</snippet>
