<snippet>
<content><![CDATA[
resource "aws_ssoadmin_application_access_scope" "${1:name}" {
  application_arn = "${2:application_arn}"  # Specifies the ARN of the application with the access scope with the targets to add or update.
  scope           = "${3:scope}"            # Specifies the name of the access scope to be associated with the specified targets.

  # authorized_targets = []  # Specifies an array list of ARNs that represent the authorized targets for this access scope.
  # region             = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_ssoadmin_application_access_scope</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS SSO Admin Application Access Scope.</description>
</snippet>
