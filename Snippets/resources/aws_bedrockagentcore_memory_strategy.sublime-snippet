<content><![CDATA[
resource "aws_bedrockagentcore_memory_strategy" "${1:name}" {
  memory_id = "${2:memory_id}"  # ID of the memory to associate with this strategy.
  name      = "${3:name}"       # Name of the memory strategy.
  type      = "${4:type}"       # Type of memory strategy.

  # description         = ""  # Description of the memory strategy.
  # namespace_templates = []  # Set containing exactly one namespace template where this strategy applies (for example /strategie...
  # region              = ""  # Region where this resource will be managed.
  # configuration {}  # Custom configuration block.
  # memory_record_schema {}  # Schema for metadata fields on records generated by this strategy.
  # reflection_configuration {}  # Configuration for the reflections created with the episodic memory strategy.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_bedrockagentcore_memory_strategy</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an AWS Bedrock AgentCore Memory Strategy.</description>
</snippet>
