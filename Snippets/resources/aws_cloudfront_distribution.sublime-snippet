<content><![CDATA[
resource "aws_cloudfront_distribution" "${1:name}" {
  enabled = ${2:false}
  default_cache_behavior {
    allowed_methods        = [${3}]
    cached_methods         = [${4}]
    target_origin_id       = "${5:target_origin_id}"
    viewer_protocol_policy = "${6:viewer_protocol_policy}"
  }
  origin {
    domain_name = "${7:domain_name}"
    origin_id   = "${8:origin_id}"
  }
  restrictions {
    geo_restriction {
      restriction_type = "${9:restriction_type}"
    }
  }
  viewer_certificate {
  }

