  # elasticsearch_config {}  # Amazon Elasticsearch settings.
  # event_bridge_config {}  # AWS EventBridge settings.
  # http_config {}  # HTTP settings.
  # lambda_config {}  # AWS Lambda settings.
  # opensearchservice_config {}  # Amazon OpenSearch Service settings.
  # relational_database_config {}
}
