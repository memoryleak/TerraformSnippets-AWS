<content><![CDATA[
resource "aws_dms_event_subscription" "${1:name}" {
  event_categories = [${2}]                # List of event categories to listen for, see DescribeEventCategories for a canonical list.
  name             = "${3:name}"           # Name of event subscription.
  sns_topic_arn    = "${4:sns_topic_arn}"  # SNS topic ARN to send events on.
  source_type      = "${5:source_type}"    # Type of source for events.

  # enabled    = false  # Whether the event subscription should be enabled.
  # region     = ""     # Region where this resource will be managed.
  # source_ids = []     # IDs of sources to listen to.
  # tags       = {}     # Map of resource tags to assign to the resource.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_dms_event_subscription</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a DMS (Data Migration Service) event subscription resource.</description>
</snippet>
