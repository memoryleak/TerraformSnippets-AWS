<content><![CDATA[
resource "aws_vpc_dhcp_options_association" "${1:name}" {
  dhcp_options_id = "${2:dhcp_options_id}"  # ID of the DHCP Options Set to associate to the VPC.
  vpc_id          = "${3:vpc_id}"           # ID of the VPC to which we would like to associate a DHCP Options Set.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_vpc_dhcp_options_association</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a VPC DHCP Options Association resource.</description>
</snippet>
