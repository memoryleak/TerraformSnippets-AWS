  # distribution              = ""     # Method used to distribute log data to the destination.
  # emit_system_fields        = []     # List of system fields to include in the log events sent to the subscription destination.
  # region                    = ""     # Region where this resource will be managed.
  # role_arn                  = ""     # ARN of an IAM role that grants CloudWatch Logs permissions to deliver ingested log events to the...
}
]]></content>
