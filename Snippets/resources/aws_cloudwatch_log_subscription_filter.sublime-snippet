resource "aws_cloudwatch_log_subscription_filter" "${1:name}" {
  destination_arn = "${2:destination_arn}"  # ARN of the destination to deliver matching log events to.
  filter_pattern  = "${3:filter_pattern}"   # Valid CloudWatch Logs filter pattern for subscribing to a filtered stream of log events.
  log_group_name  = "${4:log_group_name}"   # Name of the log group to associate the subscription filter with.
  name            = "${5:name}"             # Name for the subscription filter.

