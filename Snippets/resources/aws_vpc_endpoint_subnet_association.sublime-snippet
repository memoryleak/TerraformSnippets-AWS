<content><![CDATA[
resource "aws_vpc_endpoint_subnet_association" "${1:name}" {
  subnet_id       = "${2:subnet_id}"        # ID of the subnet to be associated with the VPC endpoint.
  vpc_endpoint_id = "${3:vpc_endpoint_id}"  # ID of the VPC endpoint with which the subnet will be associated.

  # region = ""  # Region where this resource will be managed.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_vpc_endpoint_subnet_association</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a resource to create an association between a VPC endpoint and a subnet.</description>
