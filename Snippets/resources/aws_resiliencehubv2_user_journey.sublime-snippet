resource "aws_resiliencehubv2_user_journey" "${1:name}" {
  name       = "${2:name}"        # Name of the user journey.
  system_arn = "${3:system_arn}"  # ARN of the system this user journey belongs to.

  # description = ""  # Description of the user journey.
  # policy_arn  = ""  # ARN of the resilience policy to associate with this user journey.
  # region      = ""  # Region where this resource will be managed.
}
]]></content>
