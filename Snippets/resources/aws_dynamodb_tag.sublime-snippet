<snippet>
<content><![CDATA[
resource "aws_dynamodb_tag" "${1:name}" {
  key          = "${2:key}"           # Tag name.
  resource_arn = "${3:resource_arn}"  # ARN of the DynamoDB resource to tag.
  value        = "${4:value}"         # Tag value.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_dynamodb_tag</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an individual DynamoDB resource tag</description>
</snippet>
