<content><![CDATA[
resource "aws_networkfirewall_firewall_policy" "${1:name}" {
  name = "${2:name}"  # A friendly name of the firewall policy.
  firewall_policy {
    stateless_default_actions          = [${3}]
    stateless_fragment_default_actions = [${4}]
  }

  # description = ""  # A friendly description of the firewall policy.
  # region      = ""  # Region where this resource will be managed.
  # tags        = {}  # Map of resource tags to associate with the resource.
  # encryption_configuration {}  # KMS encryption configuration settings.
}
]]></content>
<tabTrigger>aws_networkfirewall_firewall_policy</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an AWS Network Firewall Policy resource.</description>
