<content><![CDATA[
resource "aws_networkmanager_transit_gateway_connect_peer_association" "${1:name}" {
  device_id                        = "${2:device_id}"                         # ID of the device.
  global_network_id                = "${3:global_network_id}"                 # ID of the global network.
  transit_gateway_connect_peer_arn = "${4:transit_gateway_connect_peer_arn}"  # ARN of the Connect peer.

  # link_id = ""  # ID of the link.
  # timeouts {}
}
]]></content>
