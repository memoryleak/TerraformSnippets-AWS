<content><![CDATA[
resource "aws_s3_object" "${1:name}" {
  bucket = "${2:bucket}"  # Name of the bucket to put the file in.
  key    = "${3:key}"     # Name of the object once it is in the bucket.

  # acl                           = ""     # Canned ACL to apply.
  # bucket_key_enabled            = false  # Whether or not to use Amazon S3 Bucket Keys for SSE-KMS.
  # cache_control                 = ""     # Caching behavior along the request/reply chain Read w3c cache_control for further details.
  # checksum_algorithm            = ""     # Algorithm used to create the checksum for the object.
  # content                       = ""     # Literal string value to use as the object content, which will be uploaded as UTF-8-encoded text.
  # content_base64                = ""     # Base64-encoded data that will be decoded and uploaded as raw bytes for the object content.
  # content_disposition           = ""     # Presentational information for the object.
  # content_encoding              = ""     # Content encodings that have been applied to the object and thus what decoding mechanisms must be...
  # content_language              = ""     # Language the content is in e.g., en-US or en-GB.
  # content_type                  = ""     # Standard MIME type describing the format of the object data, e.g., application/octet-stream.
  # etag                          = ""     # Triggers updates when the value changes.
  # force_destroy                 = false  # Whether to allow the object to be deleted by removing any legal hold on any object version.
  # kms_key_id                    = ""     # ARN of the KMS Key to use for object encryption.
  # metadata                      = {}     # Map of keys/values to provision metadata (will be automatically prefixed by x-amz-meta-, note tha...
  # object_lock_legal_hold_status = ""     # Legal hold status that you want to apply to the specified object.
  # object_lock_mode              = ""     # Object lock retention mode that you want to apply to this object.
  # object_lock_retain_until_date = ""     # Date and time, in RFC3339 format, when this object's object lock will expire.
  # region                        = ""     # Region where this resource will be managed.
  # server_side_encryption        = ""     # Server-side encryption of the object in S3.
  # source                        = ""     # Path to a file that will be read and uploaded as raw bytes for the object content.
  # source_hash                   = ""     # Triggers updates like etag but useful to address etag encryption limitations.
  # storage_class                 = ""     # Storage Class for the object.
  # tags                          = {}     # Map of tags to assign to the object.
  # website_redirect              = ""     # Target URL for website redirect.
  # override_provider {}  # Override provider-level configuration options.
}
]]></content>
<tabTrigger>aws_s3_object</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an S3 object resource.</description>
</snippet>
