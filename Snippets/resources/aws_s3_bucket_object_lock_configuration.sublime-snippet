<content><![CDATA[
resource "aws_s3_bucket_object_lock_configuration" "${1:name}" {
  bucket = "${2:bucket}"  # Name of the bucket.

  # object_lock_enabled = ""  # Whether this bucket has an Object Lock configuration enabled.
  # region              = ""  # Region where this resource will be managed.
  # token               = ""  # Token to allow Object Lock to be enabled for an existing bucket.
  # rule {}  # Configuration block for specifying the Object Lock rule for the specified object.
}
]]></content>
