<snippet>
<content><![CDATA[
resource "aws_bedrock_enforced_guardrail_configuration" "${1:name}" {
  guardrail_arn     = "${2:guardrail_arn}"      # Guardrail ARN.
  guardrail_version = "${3:guardrail_version}"  # Numerical guardrail version.

  # region = ""  # Region where this resource will be managed.
  # model_enforcement {}  # Model-specific information for the enforced guardrail configuration.
  # selective_content_guarding {}  # Selective content guarding controls for enforced guardrails.
}
]]></content>
<tabTrigger>aws_bedrock_enforced_guardrail_configuration</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an Amazon Bedrock Enforced Guardrail Configuration.</description>
</snippet>
