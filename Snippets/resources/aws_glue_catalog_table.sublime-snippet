<content><![CDATA[
resource "aws_glue_catalog_table" "${1:name}" {
  database_name = "${2:database_name}"  # Name of the metadata database where the table metadata resides.
  name          = "${3:name}"           # Name of the table.

  # catalog_id         = ""  # ID of the Glue Catalog and database to create the table in.
  # description        = ""  # Description of the table.
  # owner              = ""  # Owner of the table.
  # parameters         = {}  # Properties associated with this table, as a map of key-value pairs.
  # region             = ""  # Region where this resource will be managed.
  # retention          = 0   # Retention time for this table.
  # table_type         = ""  # Type of this table (EXTERNAL_TABLE, VIRTUAL_VIEW, etc.).
  # view_expanded_text = ""  # If the table is a view, the expanded text of the view; otherwise null.
  # view_original_text = ""  # If the table is a view, the original text of the view; otherwise null.
  # open_table_format_input {}  # Configuration block for open table formats.
  # partition_index {}  # Configuration block for a maximum of 3 partition indexes.
  # partition_keys {}  # Configuration block of columns by which the table is partitioned.
  # storage_descriptor {}  # Configuration block for information about the physical storage of this table.
  # target_table {}  # Configuration block of a target table for resource linking.
  # view_definition {}  # Structure that contains all the information that defines the view, including the dialect or diale...
}
]]></content>
<tabTrigger>aws_glue_catalog_table</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a Glue Catalog Table.</description>
</snippet>
