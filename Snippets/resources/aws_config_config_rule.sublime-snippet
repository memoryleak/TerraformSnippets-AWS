<content><![CDATA[
resource "aws_config_config_rule" "${1:name}" {
  name = "${2:name}"  # The name of the rule
  source {
    owner = "${3:owner}"
  }

  # description                 = ""  # Description of the rule
  # input_parameters            = ""  # A string in JSON format that is passed to the AWS Config rule Lambda function.
  # maximum_execution_frequency = ""  # The maximum frequency with which AWS Config runs evaluations for a rule.
  # region                      = ""  # Region where this resource will be managed.
  # tags                        = {}  # A map of tags to assign to the resource.
  # evaluation_mode {}  # The modes the Config rule can be evaluated in.
  # scope {}  # Scope defines which resources can trigger an evaluation for the rule.
}
]]></content>
<tabTrigger>aws_config_config_rule</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an AWS Config Rule.</description>
