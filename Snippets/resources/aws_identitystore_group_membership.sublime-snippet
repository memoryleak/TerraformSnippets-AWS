<snippet>
<content><![CDATA[
resource "aws_identitystore_group_membership" "${1:name}" {
  group_id          = "${2:group_id}"           # The identifier for a group in the Identity Store.
  identity_store_id = "${3:identity_store_id}"  # Identity Store ID associated with the Single Sign-On Instance.
  member_id         = "${4:member_id}"          # The identifier for a user in the Identity Store.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_identitystore_group_membership</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS IdentityStore Group Membership.</description>
</snippet>
