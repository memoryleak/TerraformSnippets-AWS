<content><![CDATA[
resource "aws_cloudhsm_v2_cluster" "${1:name}" {
  hsm_type   = "${2:hsm_type}"  # The type of HSM module in the cluster.
  subnet_ids = [${3}]           # The IDs of subnets in which cluster will operate.

  # mode                     = ""  # The mode to use in the cluster.
  # region                   = ""  # Region where this resource will be managed.
  # source_backup_identifier = ""  # ID of Cloud HSM v2 cluster backup to be restored.
  # tags                     = {}  # A map of tags to assign to the resource.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_cloudhsm_v2_cluster</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a CloudHSM v2 resource.</description>
