resource "aws_codeartifact_domain_permissions_policy" "${1:name}" {
  domain = "${2:domain}"  # The name of the domain on which to set the resource policy.

  # domain_owner    = ""  # The account number of the AWS account that owns the domain.
  # policy_document = ""  # A JSON policy string to be set as the access control resource policy on the provided domain.
  # policy_revision = ""  # The current revision of the resource policy to be set.
  # region          = ""  # Region where this resource will be managed.
}
]]></content>
