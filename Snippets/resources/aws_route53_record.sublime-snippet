<content><![CDATA[
resource "aws_route53_record" "${1:name}" {
  name    = "${2:name}"     # The name of the record.
  type    = "${3:type}"     # The record type.
  zone_id = "${4:zone_id}"  # The ID of the hosted zone to contain this record.

  # allow_overwrite                  = false  # Allow creation of this record in Terraform to overwrite an existing record, if any.
  # health_check_id                  = ""     # The health check the record should be associated with.
  # multivalue_answer_routing_policy = false  # Set to true to indicate a multivalue answer routing policy.
  # records                          = []     # A string list of records.
  # set_identifier                   = ""     # Unique identifier to differentiate records with routing policies from one another.
  # ttl                              = 0      # The TTL of the record.
  # alias {}  # An alias block.
  # cidr_routing_policy {}  # A block indicating a routing policy based on the IP network ranges of requestors.
  # failover_routing_policy {}  # A block indicating the routing behavior when associated health check fails.
  # geolocation_routing_policy {}  # A block indicating a routing policy based on the geolocation of the requestor.
  # geoproximity_routing_policy {}  # A block indicating a routing policy based on the geoproximity of the requestor.
  # latency_routing_policy {}  # A block indicating a routing policy based on the latency between the requestor and an AWS region.
  # timeouts {}
  # weighted_routing_policy {}  # A block indicating a weighted routing policy.
}
]]></content>
<tabTrigger>aws_route53_record</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a Route53 record resource.</description>
</snippet>
