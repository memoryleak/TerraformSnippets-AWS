<content><![CDATA[
resource "aws_apigatewayv2_vpc_link" "${1:name}" {
  name               = "${2:name}"  # Name of the VPC Link.
  security_group_ids = [${3}]       # Security group IDs for the VPC Link.
  subnet_ids         = [${4}]       # Subnet IDs for the VPC Link.

  # region = ""  # Region where this resource will be managed.
  # tags   = {}  # Map of tags to assign to the VPC Link.
}
]]></content>
<tabTrigger>aws_apigatewayv2_vpc_link</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an Amazon API Gateway Version 2 VPC Link.</description>
