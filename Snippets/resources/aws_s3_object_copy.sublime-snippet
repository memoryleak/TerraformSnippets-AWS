<content><![CDATA[
resource "aws_s3_object_copy" "${1:name}" {
  bucket = "${2:bucket}"  # Name of the bucket to put the file in.
  key    = "${3:key}"     # Name of the object once it is in the bucket.
  source = "${4:source}"  # Source object for the copy operation.

