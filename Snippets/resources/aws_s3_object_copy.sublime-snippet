  # object_lock_retain_until_date = ""     # Date and time, in RFC3339 format, when this object's object lock will expire.
  # region                        = ""     # Region where this resource will be managed.
  # request_payer                 = ""     # Confirms that the requester knows that they will be charged for the request.
  # server_side_encryption        = ""     # Server-side encryption of the object in S3.
  # source_customer_algorithm     = ""     # Algorithm to use when decrypting the source object (for example, AES256).
  # source_customer_key           = ""     # Customer-provided encryption key for Amazon S3 to use to decrypt the source object.
  # source_customer_key_md5       = ""     # 128-bit MD5 digest of the encryption key according to RFC 1321.
  # storage_class                 = ""     # Desired storage class for the object.
  # tagging_directive             = ""     # Whether the object tag-set is copied from the source object or replaced with tag-set provided in...
  # tags                          = {}     # Map of tags to assign to the object.
  # website_redirect              = ""     # Target URL for website redirect.
  # grant {}  # Configuration block for header grants.
