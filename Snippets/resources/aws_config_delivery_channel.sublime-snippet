<content><![CDATA[
resource "aws_config_delivery_channel" "${1:name}" {
  s3_bucket_name = "${2:s3_bucket_name}"  # The name of the S3 bucket used to store the configuration history.

  # name           = ""  # The name of the delivery channel.
  # region         = ""  # Region where this resource will be managed.
  # s3_key_prefix  = ""  # The prefix for the specified S3 bucket.
  # s3_kms_key_arn = ""  # The ARN of the AWS KMS key used to encrypt objects delivered by AWS Config.
  # sns_topic_arn  = ""  # The ARN of the SNS topic that AWS Config delivers notifications to.
  # snapshot_delivery_properties {}  # Options for how AWS Config delivers configuration snapshots.
}
]]></content>
<tabTrigger>aws_config_delivery_channel</tabTrigger>
