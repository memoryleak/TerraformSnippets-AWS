<content><![CDATA[
resource "aws_api_gateway_method" "${1:name}" {
  authorization = "${2:authorization}"  # Type of authorization used for the method (NONE, CUSTOM, AWS_IAM, COGNITO_USER_POOLS)
  http_method   = "${3:http_method}"    # HTTP Method (GET, POST, PUT, DELETE, HEAD, OPTIONS, ANY)
  resource_id   = "${4:resource_id}"    # API resource ID
  rest_api_id   = "${5:rest_api_id}"    # ID of the associated REST API

  # api_key_required     = false  # Specify if the method requires an API key
  # authorization_scopes = []     # Authorization scopes used when the authorization is COGNITO_USER_POOLS
  # authorizer_id        = ""     # Authorizer ID to be used when the authorization is CUSTOM or COGNITO_USER_POOLS
  # operation_name       = ""     # Function name that will be given to the method when generating an SDK through API Gateway.
  # region               = ""     # Region where this resource will be managed.
  # request_models       = {}     # Map of the API models used for the request's content type where key is the content type (e.g., ap...
  # request_parameters   = {}     # Map of request parameters (from the path, query string and headers) that should be passed to the...
  # request_validator_id = ""     # ID of a aws_api_gateway_request_validator
}
]]></content>
