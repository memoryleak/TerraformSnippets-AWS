<content><![CDATA[
resource "aws_securityhub_automation_rule_v2" "${1:name}" {
  description = "${2:description}"  # A description of the automation rule.
  rule_name   = "${3:rule_name}"    # The name of the automation rule.
  rule_order  = ${4:0}              # The priority of the rule.

  # region      = ""  # Region where this resource will be managed.
  # rule_status = ""  # The status of the rule.
  # tags        = {}  # Map of tags to assign to the resource.
  # action {}  # Actions to take when the rule matches.
  # criteria {}  # Filtering type and configuration of the automation rule.
}
]]></content>
<tabTrigger>aws_securityhub_automation_rule_v2</tabTrigger>
<scope>source.terraform</scope>
<description>Manages a Security Hub V2 automation rule.</description>
