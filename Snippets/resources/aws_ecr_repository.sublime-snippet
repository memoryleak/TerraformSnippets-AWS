<content><![CDATA[
resource "aws_ecr_repository" "${1:name}" {
  name = "${2:name}"  # Name of the repository.

  # force_delete         = false  # If true, will delete the repository even if it contains images.
  # image_tag_mutability = ""     # The tag mutability setting for the repository.
  # region               = ""     # Region where this resource will be managed.
  # tags                 = {}     # A map of tags to assign to the resource.
  # encryption_configuration {}  # Encryption configuration for the repository.
  # image_scanning_configuration {}  # Configuration block that defines image scanning configuration for the repository.
  # image_tag_mutability_exclusion_filter {}  # Configuration block that defines filters to specify which image tags can override the default tag...
  # timeouts {}
}
]]></content>
<tabTrigger>aws_ecr_repository</tabTrigger>
<scope>source.terraform</scope>
