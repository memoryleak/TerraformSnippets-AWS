  # model_selection_expression          = ""     # Model selection expression for the route.
  # operation_name                      = ""     # Operation name for the route.
  # region                              = ""     # Region where this resource will be managed.
  # request_models                      = {}     # Request models for the route.
  # route_response_selection_expression = ""     # Route response selection expression for the route.
  # target                              = ""     # Target for the route, of the form integrations/*IntegrationID*, where *IntegrationID* is the iden...
  # request_parameter {}  # Request parameters for the route.
}
]]></content>
