<content><![CDATA[
resource "aws_resourceexplorer2_view" "${1:name}" {
  name = "${2:name}"  # The name of the view.

  # default_view = false  # Specifies whether the view is the _default view_ for the AWS Region.
  # region       = ""     # Region where this resource will be managed.
  # scope        = ""     # The root ARN of the account, an organizational unit (OU), or an organization ARN.
  # tags         = {}     # Key-value map of resource tags.
  # filters {}  # Specifies which resources are included in the results of queries made using this view.
  # included_property {}  # Optional fields to be included in search results from this view.
}
]]></content>
<tabTrigger>aws_resourceexplorer2_view</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a resource to manage a Resource Explorer view.</description>
