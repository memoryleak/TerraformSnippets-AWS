<content><![CDATA[
resource "aws_lb_listener_certificate" "${1:name}" {
  certificate_arn = "${2:certificate_arn}"  # The ARN of the certificate to attach to the listener.
  listener_arn    = "${3:listener_arn}"     # The ARN of the listener to which to attach the certificate.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_lb_listener_certificate</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a Load Balancer Listener Certificate resource.</description>
