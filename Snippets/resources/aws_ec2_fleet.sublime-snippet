<content><![CDATA[
resource "aws_ec2_fleet" "${1:name}" {
  launch_template_config {
  }
  target_capacity_specification {
    default_target_capacity_type = "${2:default_target_capacity_type}"
    total_target_capacity        = ${3:0}
  }

  # context                             = ""     # Reserved.
