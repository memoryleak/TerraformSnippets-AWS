  # replace_unhealthy_instances         = false  # Whether EC2 Fleet should replace unhealthy instances.
  # tags                                = {}     # Map of Fleet tags.
  # terminate_instances                 = false  # Whether to terminate instances for an EC2 Fleet if it is deleted successfully.
  # terminate_instances_with_expiration = false  # Whether running instances should be terminated when the EC2 Fleet expires.
  # type                                = ""     # The type of request.
  # valid_from                          = ""     # The start date and time of the request, in UTC format (for example, YYYY-MM-DDTHH:MM:SSZ).
  # valid_until                         = ""     # The end date and time of the request, in UTC format (for example, YYYY-MM-DDTHH:MM:SSZ).
