<content><![CDATA[
resource "aws_dx_public_virtual_interface" "${1:name}" {
  address_family        = "${2:address_family}"  # The address family for the BGP peer.
  bgp_asn               = ${3:0}                 # BGP autonomous system number as an integer between 1 and 2147483646.
  connection_id         = "${4:connection_id}"   # The ID of the Direct Connect connection (or LAG) on which to create the virtual interface.
  name                  = "${5:name}"            # The name for the virtual interface.
  route_filter_prefixes = [${6}]                 # A list of routes to be advertised to the AWS network in this region.
  vlan                  = ${7:0}                 # The VLAN ID.

  # amazon_address   = ""  # The IPv4 CIDR address to use to send traffic to Amazon.
  # bgp_auth_key     = ""  # The authentication key for BGP configuration.
  # customer_address = ""  # The IPv4 CIDR destination address to which Amazon should send traffic.
  # rate_limit       = ""  # Maximum bandwidth allocation for the virtual interface, restricting the bandwidth it can use on t...
  # region           = ""  # Region where this resource will be managed.
  # tags             = {}  # A map of tags to assign to the resource.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_dx_public_virtual_interface</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a Direct Connect public virtual interface resource.</description>
