<content><![CDATA[
resource "aws_vpc" "${1:name}" {
  # assign_generated_ipv6_cidr_block     = false  # Requests an Amazon-provided IPv6 CIDR block with a /56 prefix length for the VPC.
  # cidr_block                           = ""     # IPv4 CIDR block for the VPC.
  # enable_dns_hostnames                 = false  # Whether to enable DNS hostnames in the VPC.
  # enable_dns_support                   = false  # Whether to enable DNS support in the VPC.
  # enable_network_address_usage_metrics = false  # Whether to enable Network Address Usage metrics for your VPC.
  # instance_tenancy                     = ""     # Tenancy option for instances launched into the VPC.
  # ipv4_ipam_pool_id                    = ""     # ID of an IPv4 IPAM pool you want to use for allocating this VPC's CIDR.
  # ipv4_netmask_length                  = 0      # Netmask length of the IPv4 CIDR you want to allocate to this VPC.
  # ipv6_cidr_block                      = ""     # IPv6 CIDR block to request from an IPAM Pool.
  # ipv6_cidr_block_network_border_group = ""     # By default when an IPv6 CIDR is assigned to a VPC a default ipv6_cidr_block_network_border_group...
  # ipv6_ipam_pool_id                    = ""     # IPAM Pool ID for a IPv6 pool.
  # ipv6_netmask_length                  = 0      # Netmask length to request from IPAM Pool.
  # region                               = ""     # Region where this resource will be managed.
  # tags                                 = {}     # Map of tags to assign to the resource.
}
]]></content>
<tabTrigger>aws_vpc</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a VPC resource.</description>
</snippet>
