<snippet>
<content><![CDATA[
resource "aws_lambda_resource_policy" "${1:name}" {
  policy       = "${2:policy}"        # JSON-formatted resource-based policy document to attach to the Lambda resource.
  resource_arn = "${3:resource_arn}"  # ARN of the Lambda function, function version, or function alias to attach the policy to.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_lambda_resource_policy</tabTrigger>
<scope>source.terraform</scope>
<description>Manages a full IAM resource-based policy for an AWS Lambda resource.</description>
</snippet>
