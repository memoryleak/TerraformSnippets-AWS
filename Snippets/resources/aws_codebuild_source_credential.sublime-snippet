<snippet>
<content><![CDATA[
resource "aws_codebuild_source_credential" "${1:name}" {
  auth_type   = "${2:auth_type}"    # The type of authentication used to connect to a GitHub, GitHub Enterprise, or Bitbucket
  server_type = "${3:server_type}"  # The source provider used for this project.
  token       = "${4:token}"        # For a GitHub and GitHub Enterprise, this is the personal access token.

  # region    = ""  # Region where this resource will be managed.
  # user_name = ""  # The Bitbucket username when the authType is BASIC_AUTH.
}
]]></content>
<tabTrigger>aws_codebuild_source_credential</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a CodeBuild Source Credential resource.</description>
</snippet>
