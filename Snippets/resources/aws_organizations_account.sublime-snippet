<snippet>
<content><![CDATA[
resource "aws_organizations_account" "${1:name}" {
  email = "${2:email}"  # Email address of the owner to assign to the new member account.
  name  = "${3:name}"   # Friendly name for the member account.

  # close_on_deletion          = false  # If true, a deletion event will close the account.
  # create_govcloud            = false  # Whether to also create a GovCloud account.
  # iam_user_access_to_billing = ""     # If set to ALLOW, the new account enables IAM users and roles to access account billing informatio...
  # parent_id                  = ""     # Parent Organizational Unit ID or Root ID for the account.
  # role_name                  = ""     # The name of an IAM role that Organizations automatically preconfigures in the new member account.
  # tags                       = {}     # Key-value map of resource tags.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_organizations_account</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a resource to create a member account in the current AWS Organization.</description>
</snippet>
