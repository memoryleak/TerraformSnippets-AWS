resource "aws_cloudwatch_log_delivery_destination" "${1:name}" {
  name = "${2:name}"  # The name for this delivery destination.

  # delivery_destination_type = ""  # The type of delivery destination.
  # output_format             = ""  # The format of the logs that are sent to this delivery destination.
