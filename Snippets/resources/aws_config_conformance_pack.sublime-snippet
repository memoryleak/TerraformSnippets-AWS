<content><![CDATA[
resource "aws_config_conformance_pack" "${1:name}" {
  name = "${2:name}"  # The name of the conformance pack.

  # delivery_s3_bucket     = ""  # Amazon S3 bucket where AWS Config stores conformance pack templates.
  # delivery_s3_key_prefix = ""  # The prefix for the Amazon S3 bucket.
  # region                 = ""  # Region where this resource will be managed.
  # template_body          = ""  # A string containing full conformance pack template body.
  # template_s3_uri        = ""  # Location of file, e.g., s3://bucketname/prefix, containing the template body.
  # input_parameter {}  # Set of configuration blocks describing input parameters passed to the conformance pack template.
}
]]></content>
<tabTrigger>aws_config_conformance_pack</tabTrigger>
<scope>source.terraform</scope>
<description>Manages a Config Conformance Pack</description>
</snippet>
