<content><![CDATA[
resource "aws_sfn_alias" "${1:name}" {
  name = "${2:name}"  # Name for the alias you are creating.
  routing_configuration {
    state_machine_version_arn = "${3:state_machine_version_arn}"
    weight                    = ${4:0}
  }

  # description = ""  # Description of the alias.
  # region      = ""  # Region where this resource will be managed.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_sfn_alias</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a Step Function State Machine Alias.</description>
</snippet>
