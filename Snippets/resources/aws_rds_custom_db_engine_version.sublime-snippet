<snippet>
<content><![CDATA[
resource "aws_rds_custom_db_engine_version" "${1:name}" {
  engine         = "${2:engine}"          # Name of the database engine.
  engine_version = "${3:engine_version}"  # Version of the database engine.

  # database_installation_files_s3_bucket_name = ""  # Name of the Amazon S3 bucket that contains the database installation files.
  # database_installation_files_s3_prefix      = ""  # Prefix for the Amazon S3 bucket that contains the database installation files.
  # description                                = ""  # Description of the CEV.
  # filename                                   = ""  # Name of the manifest file within the local filesystem.
  # kms_key_id                                 = ""  # ARN of the AWS KMS key that is used to encrypt the database installation files.
  # manifest                                   = ""  # Manifest file, in JSON format, that contains the list of database installation files.
  # manifest_hash                              = ""  # Triggers updates.
  # region                                     = ""  # Region where this resource will be managed.
  # source_image_id                            = ""  # ID of the AMI to create the CEV from.
  # status                                     = ""  # Status of the CEV.
  # tags                                       = {}  # Map of tags to assign to the resource.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_rds_custom_db_engine_version</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an custom engine version (CEV) resource for Amazon RDS Custom.</description>
</snippet>
