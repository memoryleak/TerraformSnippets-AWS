<snippet>
<content><![CDATA[
resource "aws_secretsmanager_tag" "${1:name}" {
  key       = "${2:key}"        # Tag name.
  secret_id = "${3:secret_id}"  # ID of the AWS Secrets Manager secret to tag.
  value     = "${4:value}"      # Tag value.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_secretsmanager_tag</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an individual AWS Secrets Manager secret tag</description>
</snippet>
