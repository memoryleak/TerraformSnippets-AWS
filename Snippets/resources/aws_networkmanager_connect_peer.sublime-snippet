<content><![CDATA[
resource "aws_networkmanager_connect_peer" "${1:name}" {
  connect_attachment_id = "${2:connect_attachment_id}"  # ID of the connection attachment.
  peer_address          = "${3:peer_address}"           # Connect peer address.

  # core_network_address = ""  # Connect peer core network address.
  # inside_cidr_blocks   = []  # Inside IP addresses used for BGP peering.
  # subnet_arn           = ""  # Subnet ARN for the Connect peer.
  # tags                 = {}  # Key-value tags for the attachment.
  # bgp_options {}  # Connect peer BGP options.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_networkmanager_connect_peer</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an AWS Network Manager Connect Peer.</description>
</snippet>
