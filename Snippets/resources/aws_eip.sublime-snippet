<content><![CDATA[
resource "aws_eip" "${1:name}" {
  # address                   = ""  # IP address from an EC2 BYOIP pool.
  # associate_with_private_ip = ""  # User-specified primary or secondary private IP address to associate with the Elastic IP address.
  # customer_owned_ipv4_pool  = ""  # ID  of a customer-owned address pool.
  # domain                    = ""  # Indicates if this EIP is for use in VPC (vpc).
  # instance                  = ""  # EC2 instance ID.
  # ipam_pool_id              = ""  # The ID of an IPAM pool which has an Amazon-provided or BYOIP public IPv4 CIDR provisioned to it.
  # network_border_group      = ""  # Location from which the IP address is advertised.
  # network_interface         = ""  # Network interface ID to associate with.
  # public_ipv4_pool          = ""  # EC2 IPv4 address pool identifier or amazon.
  # region                    = ""  # Region where this resource will be managed.
  # tags                      = {}  # Map of tags to assign to the resource.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_eip</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an Elastic IP resource.</description>
