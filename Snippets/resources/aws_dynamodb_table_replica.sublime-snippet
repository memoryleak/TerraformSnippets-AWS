<snippet>
<content><![CDATA[
resource "aws_dynamodb_table_replica" "${1:name}" {
  global_table_arn = "${2:global_table_arn}"  # ARN of the _main_ or global table which this resource will replicate.

  # deletion_protection_enabled = false  # Whether deletion protection is enabled (true) or disabled (false) on the table replica.
  # kms_key_arn                 = ""     # ARN of the CMK that should be used for the AWS KMS encryption.
  # point_in_time_recovery      = false  # Whether to enable Point In Time Recovery for the table replica.
  # region                      = ""     # Region where this resource will be managed.
  # table_class_override        = ""     # Storage class of the table replica.
  # tags                        = {}     # Map of tags to populate on the created table.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_dynamodb_table_replica</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a DynamoDB table replica resource</description>
</snippet>
