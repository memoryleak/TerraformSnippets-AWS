<snippet>
<content><![CDATA[
resource "aws_db_snapshot" "${1:name}" {
  db_instance_identifier = "${2:db_instance_identifier}"  # DB instance identifier from which to take the snapshot.
  db_snapshot_identifier = "${3:db_snapshot_identifier}"  # Identifier for the snapshot.

  # region          = ""  # Region where this resource will be managed.
  # shared_accounts = []  # List of AWS Account IDs to share the snapshot with.
  # tags            = {}  # Key-value map of resource tags.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_db_snapshot</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an RDS database instance snapshot.</description>
</snippet>
