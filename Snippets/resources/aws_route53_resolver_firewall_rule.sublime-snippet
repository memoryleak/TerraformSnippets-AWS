<content><![CDATA[
resource "aws_route53_resolver_firewall_rule" "${1:name}" {
  action                 = "${2:action}"                  # The action that DNS Firewall should take on a DNS query when it matches one of the domains in the...
  firewall_rule_group_id = "${3:firewall_rule_group_id}"  # The unique identifier of the firewall rule group where you want to create the rule.
  name                   = "${4:name}"                    # A name that lets you identify the rule, to manage and use it.
  priority               = ${5:0}                         # The setting that determines the processing order of the rule in the rule group.

  # block_override_dns_type            = ""  # The DNS record's type.
  # block_override_domain              = ""  # The custom DNS record to send back in response to the query.
  # block_override_ttl                 = 0   # The recommended amount of time, in seconds, for the DNS resolver or web browser to cache the prov...
  # block_response                     = ""  # The way that you want DNS Firewall to block the request.
  # confidence_threshold               = ""  # The confidence threshold for DNS Firewall Advanced rules.
  # dns_threat_protection              = ""  # The type of DNS Firewall Advanced rule.
  # firewall_domain_list_id            = ""  # The ID of the domain list that you want to use in the rule.
  # firewall_domain_redirection_action = ""  # Evaluate DNS redirection in the DNS redirection chain, such as CNAME, DNAME, ot ALIAS.
  # q_type                             = ""  # The query type you want the rule to evaluate.
  # region                             = ""  # Region where this resource will be managed.
}
]]></content>
