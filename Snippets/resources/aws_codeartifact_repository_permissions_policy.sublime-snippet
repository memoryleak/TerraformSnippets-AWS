<content><![CDATA[
resource "aws_codeartifact_repository_permissions_policy" "${1:name}" {
  domain          = "${2:domain}"           # The name of the domain on which to set the resource policy.
  policy_document = "${3:policy_document}"  # A JSON policy string to be set as the access control resource policy on the provided domain.
  repository      = "${4:repository}"       # The name of the repository to set the resource policy on.

  # domain_owner    = ""  # The account number of the AWS account that owns the domain.
  # policy_revision = ""  # The current revision of the resource policy to be set.
  # region          = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_codeartifact_repository_permissions_policy</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a CodeArtifact Repository Permissions Policy resource.</description>
</snippet>
