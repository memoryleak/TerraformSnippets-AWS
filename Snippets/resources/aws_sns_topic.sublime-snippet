<content><![CDATA[
resource "aws_sns_topic" "${1:name}" {
  # application_failure_feedback_role_arn    = ""     # IAM role for failure feedback
  # application_success_feedback_role_arn    = ""     # The IAM role permitted to receive success feedback for this topic
  # application_success_feedback_sample_rate = 0      # Percentage of success to sample
  # archive_policy                           = ""     # The message archive policy for FIFO topics.
  # content_based_deduplication              = false  # Enables content-based deduplication for FIFO topics.
  # delivery_policy                          = ""     # The SNS delivery policy.
  # display_name                             = ""     # The display name for the topic
  # fifo_throughput_scope                    = ""     # Enables higher throughput for FIFO topics by adjusting the scope of deduplication.
  # fifo_topic                               = false  # Boolean indicating whether or not to create a FIFO (first-in-first-out) topic.
  # firehose_failure_feedback_role_arn       = ""     # IAM role for failure feedback
  # firehose_success_feedback_role_arn       = ""     # The IAM role permitted to receive success feedback for this topic
  # firehose_success_feedback_sample_rate    = 0      # Percentage of success to sample
  # http_failure_feedback_role_arn           = ""     # IAM role for failure feedback
  # http_success_feedback_role_arn           = ""     # The IAM role permitted to receive success feedback for this topic
  # http_success_feedback_sample_rate        = 0      # Percentage of success to sample
  # kms_master_key_id                        = ""     # The ID of an AWS-managed customer master key (CMK) for Amazon SNS or a custom CMK.
  # lambda_failure_feedback_role_arn         = ""     # IAM role for failure feedback
  # lambda_success_feedback_role_arn         = ""     # The IAM role permitted to receive success feedback for this topic
  # lambda_success_feedback_sample_rate      = 0      # Percentage of success to sample
  # maximum_message_size                     = 0      # The maximum size, in bytes, of a message that can be published to the topic.
  # name                                     = ""     # The name of the topic.
  # name_prefix                              = ""     # Creates a unique name beginning with the specified prefix.
  # policy                                   = ""     # The fully-formed AWS policy as JSON.
  # region                                   = ""     # Region where this resource will be managed.
  # signature_version                        = 0      # If SignatureVersion should be 1 (SHA1) or 2 (SHA256).
  # sqs_failure_feedback_role_arn            = ""     # IAM role for failure feedback
  # sqs_success_feedback_role_arn            = ""     # The IAM role permitted to receive success feedback for this topic
  # sqs_success_feedback_sample_rate         = 0      # Percentage of success to sample
  # tags                                     = {}     # Key-value map of resource tags.
  # tracing_config                           = ""     # Tracing mode of an Amazon SNS topic.
}
]]></content>
<tabTrigger>aws_sns_topic</tabTrigger>
<scope>source.terraform</scope>
<description>Provides an SNS topic resource.</description>
