<snippet>
<content><![CDATA[
resource "aws_chatbot_teams_channel_configuration" "${1:name}" {
  channel_id         = "${2:channel_id}"          # ID of the Microsoft Teams channel.
  configuration_name = "${3:configuration_name}"  # Name of the Microsoft Teams channel configuration.
  iam_role_arn       = "${4:iam_role_arn}"        # ARN of the IAM role that defines the permissions for AWS Chatbot.
  team_id            = "${5:team_id}"             # ID of the Microsoft Team authorized with AWS Chatbot.
  tenant_id          = "${6:tenant_id}"           # ID of the Microsoft Teams tenant.

  # channel_name                = ""     # Name of the Microsoft Teams channel.
  # guardrail_policy_arns       = []     # List of IAM policy ARNs that are applied as channel guardrails.
  # logging_level               = ""     # Logging levels include ERROR, INFO, or NONE.
  # region                      = ""     # Region where this resource will be managed.
  # sns_topic_arns              = []     # ARNs of the SNS topics that deliver notifications to AWS Chatbot.
  # tags                        = {}     # Map of tags assigned to the resource.
  # team_name                   = ""     # Name of the Microsoft Teams team.
  # user_authorization_required = false  # Enables use of a user role requirement in your chat configuration.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_chatbot_teams_channel_configuration</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS Chatbot Microsoft Teams Channel Configuration.</description>
</snippet>
