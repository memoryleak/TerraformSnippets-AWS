<content><![CDATA[
resource "aws_sagemaker_hub_content_reference" "${1:name}" {
  hub_content_name                 = "${2:hub_content_name}"                  # Name of the hub content reference.
  hub_name                         = "${3:hub_name}"                          # Name of the private SageMaker Hub to add the content reference to.
  sagemaker_public_hub_content_arn = "${4:sagemaker_public_hub_content_arn}"  # ARN of the public SageMaker JumpStart hub content to reference.

  # min_version = ""  # Minimum version of the hub content to reference.
  # region      = ""  # Region where this resource will be managed.
  # tags        = {}  # Map of tags to assign to the resource.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_sagemaker_hub_content_reference</tabTrigger>
<scope>source.terraform</scope>
<description>Manages a SageMaker AI Hub Content Reference resource.</description>
</snippet>
