  # local_ipv4_network_cidr                 = ""     # IPv4 CIDR on the customer gateway (on-premises) side of the VPN connection.
  # local_ipv6_network_cidr                 = ""     # IPv6 CIDR on the customer gateway (on-premises) side of the VPN connection.
