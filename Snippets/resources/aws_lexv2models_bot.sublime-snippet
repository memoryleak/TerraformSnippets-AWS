<snippet>
<content><![CDATA[
resource "aws_lexv2models_bot" "${1:name}" {
  idle_session_ttl_in_seconds = ${2:0}           # Time, in seconds, that Amazon Lex should keep information about a user's conversation with the bot.
  name                        = "${3:name}"      # Name of the bot.
  role_arn                    = "${4:role_arn}"  # ARN of an IAM role that has permission to access the bot.

  # description         = ""  # Description of the bot.
  # region              = ""  # Region where this resource will be managed.
  # tags                = {}  # List of tags to add to the bot.
  # test_bot_alias_tags = {}  # List of tags to add to the test alias for a bot.
  # type                = ""  # Type of a bot to create.
  # data_privacy {}  # Provides information on additional privacy protections Amazon Lex should use with the bot's data.
  # members {}  # List of bot members in a network to be created.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_lexv2models_bot</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS Lex V2 Models Bot.</description>
</snippet>
