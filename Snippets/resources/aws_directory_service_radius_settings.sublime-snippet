<content><![CDATA[
resource "aws_directory_service_radius_settings" "${1:name}" {
  authentication_protocol = "${2:authentication_protocol}"  # The protocol specified for your RADIUS endpoints.
  directory_id            = "${3:directory_id}"             # The identifier of the directory for which you want to manager RADIUS settings.
  display_label           = "${4:display_label}"            # Display label.
  radius_port             = ${5:0}                          # The port that your RADIUS server is using for communications.
  radius_retries          = ${6:0}                          # The maximum number of times that communication with the RADIUS server is attempted.
  radius_servers          = [${7}]                          # An array of strings that contains the fully qualified domain name (FQDN) or IP addresses of the R...
  radius_timeout          = ${8:0}                          # The amount of time, in seconds, to wait for the RADIUS server to respond.
  shared_secret           = "${9:shared_secret}"            # Required for enabling RADIUS on the directory.

  # region            = ""     # Region where this resource will be managed.
  # use_same_username = false  # Not currently used.
  # timeouts {}
}
]]></content>
