<snippet>
<content><![CDATA[
resource "aws_guardduty_member" "${1:name}" {
  account_id  = "${2:account_id}"   # AWS account ID for member account.
  detector_id = "${3:detector_id}"  # Detector ID of the GuardDuty account where you want to create member accounts.
  email       = "${4:email}"        # Email address for member account.

  # disable_email_notification = false  # Boolean whether an email notification is sent to the accounts.
  # invitation_message         = ""     # Message for invitation.
  # invite                     = false  # Boolean whether to invite the account to GuardDuty as a member.
  # region                     = ""     # Region where this resource will be managed.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_guardduty_member</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a resource to manage a GuardDuty member</description>
</snippet>
