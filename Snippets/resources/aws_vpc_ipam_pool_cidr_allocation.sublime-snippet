<snippet>
<content><![CDATA[
resource "aws_vpc_ipam_pool_cidr_allocation" "${1:name}" {
  ipam_pool_id = "${2:ipam_pool_id}"  # ID of the pool to which you want to assign a CIDR.

  # cidr             = ""  # CIDR you want to assign to the pool.
  # description      = ""  # Description for the allocation.
  # disallowed_cidrs = []  # Exclude a particular CIDR range from being returned by the pool.
  # netmask_length   = 0   # Netmask length of the CIDR you would like to allocate to the IPAM pool.
  # region           = ""  # Region where this resource will be managed.
  # tags             = {}  # Map of tags to assign to the resource.
}
]]></content>
<tabTrigger>aws_vpc_ipam_pool_cidr_allocation</tabTrigger>
<scope>source.terraform</scope>
<description>Allocates (reserves) a CIDR from an IPAM address pool, preventing usage by IPAM.</description>
</snippet>
