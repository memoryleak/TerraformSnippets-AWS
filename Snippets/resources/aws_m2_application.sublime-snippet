<content><![CDATA[
resource "aws_m2_application" "${1:name}" {
  engine_type = "${2:engine_type}"  # Engine type must be microfocus | bluage.
  name        = "${3:name}"         # Unique identifier of the application.

  # description = ""  # Description of the application.
  # kms_key_id  = ""  # KMS Key to use for the Application.
  # region      = ""  # Region where this resource will be managed.
  # role_arn    = ""  # ARN of role for application to use to access AWS resources.
  # tags        = {}  # Map of tags assigned to the resource.
  # definition {}  # Application definition for this application.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_m2_application</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS Mainframe Modernization Application.</description>
</snippet>
