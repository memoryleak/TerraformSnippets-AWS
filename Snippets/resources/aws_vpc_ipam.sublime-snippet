resource "aws_vpc_ipam" "${1:name}" {
  operating_regions {
    region_name = "${2:region_name}"
  }

  # cascade            = false  # Whether to quickly delete an IPAM, private scopes, pools in private scopes, and any allocations i...
  # description        = ""     # Description for the IPAM.
  # enable_private_gua = false  # Whether to use your own GUA ranges as private IPv6 addresses.
  # metered_account    = ""     # AWS account that is charged for active IP addresses managed in IPAM.
  # region             = ""     # Region where this resource will be managed.
  # tags               = {}     # Map of tags to assign to the resource.
  # tier               = ""     # specifies the IPAM tier.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_vpc_ipam</tabTrigger>
