<content><![CDATA[
resource "aws_bedrockagent_agent_action_group" "${1:name}" {
  action_group_name = "${2:action_group_name}"  # Name of the action group.
  agent_id          = "${3:agent_id}"           # Unique identifier of the agent for which to create the action group.
  agent_version     = "${4:agent_version}"      # Version of the agent for which to create the action group.

  # action_group_state            = ""     # Whether the action group is available for the agent to invoke or not when sending an InvokeAgent...
  # description                   = ""     # Description of the action group.
  # parent_action_group_signature = ""     # To allow your agent to request the user for additional information when trying to complete a task...
  # prepare_agent                 = false  # Whether to prepare the agent after creation or modification.
  # region                        = ""     # Region where this resource will be managed.
  # skip_resource_in_use_check    = false  # Whether to skip the in-use check when deleting the action group.
  # action_group_executor {}  # ARN of the Lambda function containing the business logic that is carried out upon invoking the ac...
  # api_schema {}  # Either details about the S3 object containing the OpenAPI schema for the action group or the JSON...
  # function_schema {}  # Function schema for the action group.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_bedrockagent_agent_action_group</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an AWS Agents for Amazon Bedrock Agent Action Group.</description>
