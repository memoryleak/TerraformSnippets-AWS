resource "aws_sagemaker_domain" "${1:name}" {
  auth_mode   = "${2:auth_mode}"    # The mode of authentication that members use to access the domain.
  domain_name = "${3:domain_name}"  # The domain name.
  subnet_ids  = [${4}]              # The VPC subnets that Studio uses for communication.
  vpc_id      = "${5:vpc_id}"       # ID of the VPC that Studio uses for communication.
  default_user_settings {
    execution_role = "${6:execution_role}"
  }

