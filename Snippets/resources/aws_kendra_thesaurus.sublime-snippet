<snippet>
<content><![CDATA[
resource "aws_kendra_thesaurus" "${1:name}" {
  index_id = "${2:index_id}"  # Identifier of the index for a thesaurus.
  name     = "${3:name}"      # Name for the thesaurus.
  role_arn = "${4:role_arn}"  # IAM (Identity and Access Management) role used to access the thesaurus file in S3.
  source_s3_path {
    bucket = "${5:bucket}"
    key    = "${6:key}"
  }

  # description = ""  # Description for a thesaurus.
  # region      = ""  # Region where this resource will be managed.
  # tags        = {}  # Key-value map of resource tags.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_kendra_thesaurus</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS Kendra Thesaurus.</description>
</snippet>
