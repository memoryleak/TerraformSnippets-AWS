<snippet>
<content><![CDATA[
resource "aws_s3tables_table_bucket_replication" "${1:name}" {
  role             = "${2:role}"              # ARN referencing the IAM role assumed by S3 when replicating tables in this bucket.
  table_bucket_arn = "${3:table_bucket_arn}"  # ARN referencing the Table Bucket that owns this replication configuration.

  # region = ""  # Region where this resource will be managed.
  # rule {}  # Replication rules.
}
]]></content>
<tabTrigger>aws_s3tables_table_bucket_replication</tabTrigger>
<scope>source.terraform</scope>
<description>Manages Amazon S3 Tables Table Bucket Replication configuration.</description>
</snippet>
