resource "aws_ecs_capacity_provider" "${1:name}" {
  name = "${2:name}"  # Name of the capacity provider.

  # cluster = ""  # Name of the ECS cluster.
  # region  = ""  # Region where this resource will be managed.
  # tags    = {}  # Key-value map of resource tags.
  # auto_scaling_group_provider {}  # Configuration block for the provider for the ECS Auto Scaling group.
  # managed_instances_provider {}  # Configuration block for the managed instances provider.
}
