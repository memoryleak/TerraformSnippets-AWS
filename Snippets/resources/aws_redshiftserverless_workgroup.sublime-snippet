resource "aws_redshiftserverless_workgroup" "${1:name}" {
  namespace_name = "${2:namespace_name}"  # The name of the namespace.
  workgroup_name = "${3:workgroup_name}"  # The name of the workgroup.

  # base_capacity        = 0      # The base data warehouse capacity of the workgroup in Redshift Processing Units (RPUs).
