<content><![CDATA[
resource "aws_sqs_queue_redrive_policy" "${1:name}" {
  queue_url      = "${2:queue_url}"       # The URL of the SQS Queue to which to attach the policy
  redrive_policy = "${3:redrive_policy}"  # The JSON redrive policy for the SQS queue.

  # region = ""  # Region where this resource will be managed.
}
]]></content>
<tabTrigger>aws_sqs_queue_redrive_policy</tabTrigger>
<scope>source.terraform</scope>
<description>Provides a SQS Queue Redrive Policy resource.</description>
