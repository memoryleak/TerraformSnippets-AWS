<snippet>
<content><![CDATA[
resource "aws_lambdaweb_resource_policy" "${1:name}" {
  policy       = "${2:policy}"        # Resource-based IAM policy document as JSON.
  resource_arn = "${3:resource_arn}"  # ARN of the Lambda Web function the policy is attached to.

  # region = ""  # Region where this resource is managed.
}
]]></content>
<tabTrigger>aws_lambdaweb_resource_policy</tabTrigger>
<scope>source.terraform</scope>
<description>Manages a resource policy for an AWS Lambda Web function.</description>
</snippet>
