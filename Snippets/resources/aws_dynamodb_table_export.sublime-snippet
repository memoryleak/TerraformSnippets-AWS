<content><![CDATA[
resource "aws_dynamodb_table_export" "${1:name}" {
  s3_bucket = "${2:s3_bucket}"  # Name of the Amazon S3 bucket to export the snapshot to.
  table_arn = "${3:table_arn}"  # ARN associated with the table to export.

  # export_format     = ""  # Format for the exported data.
  # export_time       = ""  # Time in RFC3339 format from which to export table data.
  # export_type       = ""  # Whether to execute as a full export or incremental export.
  # region            = ""  # Region where this resource will be managed.
  # s3_bucket_owner   = ""  # ID of the AWS account that owns the bucket the export will be stored in.
  # s3_prefix         = ""  # Amazon S3 bucket prefix to use as the file name and path of the exported snapshot.
  # s3_sse_algorithm  = ""  # Type of encryption used on the bucket where export data will be stored.
  # s3_sse_kms_key_id = ""  # ID of the AWS KMS managed key used to encrypt the S3 bucket where export data will be stored (if...
  # incremental_export_specification {}
  # timeouts {}
}
]]></content>
<tabTrigger>aws_dynamodb_table_export</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS DynamoDB Table Export.</description>
