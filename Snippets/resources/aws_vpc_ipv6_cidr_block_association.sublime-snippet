<snippet>
<content><![CDATA[
resource "aws_vpc_ipv6_cidr_block_association" "${1:name}" {
  vpc_id = "${2:vpc_id}"  # ID of the VPC to make the association with.

  # assign_generated_ipv6_cidr_block = false  # Whether to request an Amazon-provided IPv6 CIDR block with a /56 prefix length for the VPC.
  # ipv6_cidr_block                  = ""     # IPv6 CIDR block for the VPC.
  # ipv6_ipam_pool_id                = ""     # ID of an IPv6 IPAM pool you want to use for allocating this VPC's CIDR.
  # ipv6_netmask_length              = 0      # Netmask length of the IPv6 CIDR you want to allocate to this VPC.
  # ipv6_pool                        = ""     # ID of an IPv6 address pool from which to allocate the IPv6 CIDR block.
  # region                           = ""     # Region where this resource will be managed.
  # timeouts {}
}
]]></content>
<tabTrigger>aws_vpc_ipv6_cidr_block_association</tabTrigger>
<scope>source.terraform</scope>
<description>Associate additional IPv6 CIDR blocks with a VPC</description>
</snippet>
