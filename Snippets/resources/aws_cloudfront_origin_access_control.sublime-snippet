<snippet>
<content><![CDATA[
resource "aws_cloudfront_origin_access_control" "${1:name}" {
  name                              = "${2:name}"                               # A name that identifies the Origin Access Control.
  origin_access_control_origin_type = "${3:origin_access_control_origin_type}"  # The type of origin that this Origin Access Control is for.
  signing_behavior                  = "${4:signing_behavior}"                   # Specifies which requests CloudFront signs.
  signing_protocol                  = "${5:signing_protocol}"                   # Determines how CloudFront signs (authenticates) requests.

  # description = ""  # The description of the Origin Access Control.
}
]]></content>
<tabTrigger>aws_cloudfront_origin_access_control</tabTrigger>
<scope>source.terraform</scope>
<description>Terraform resource for managing an AWS CloudFront Origin Access Control.</description>
</snippet>
