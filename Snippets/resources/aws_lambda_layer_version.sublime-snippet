resource "aws_lambda_layer_version" "${1:name}" {
  layer_name = "${2:layer_name}"  # Unique name for your Lambda Layer.

  # compatible_architectures = []     # List of Architectures this layer is compatible with.
  # compatible_runtimes      = []     # List of Runtimes this layer is compatible with.
  # description              = ""     # Description of what your Lambda Layer does.
  # filename                 = ""     # Path to the function's deployment package within the local filesystem.
  # license_info             = ""     # License info for your Lambda Layer.
  # region                   = ""     # Region where this resource will be managed.
  # s3_bucket                = ""     # S3 bucket location containing the function's deployment package.
  # s3_key                   = ""     # S3 key of an object containing the function's deployment package.
  # s3_object_version        = ""     # Object version containing the function's deployment package.
  # skip_destroy             = false  # Whether to retain the old version of a previously deployed Lambda Layer.
  # source_code_hash         = ""     # Virtual attribute used to trigger replacement when source code changes.
}
]]></content>
