  # tags                    = {}     # Map of tags to assign to the resource.
  # inference_specification {}  # Configuration for inference jobs that use this algorithm.
  # timeouts {}
  # training_specification {}  # Configuration for training jobs that use this algorithm.
  # validation_specification {}  # Configuration used to validate the algorithm.
}
