<snippet>
<content><![CDATA[
resource "aws_api_gateway_stage" "${1:name}" {
  deployment_id = "${2:deployment_id}"  # ID of the deployment that the stage points to
  rest_api_id   = "${3:rest_api_id}"    # ID of the associated REST API
  stage_name    = "${4:stage_name}"     # Name of the stage

  # cache_cluster_enabled = false  # Whether a cache cluster is enabled for the stage
  # cache_cluster_size    = ""     # Size of the cache cluster for the stage, if enabled.
  # client_certificate_id = ""     # Identifier of a client certificate for the stage.
  # description           = ""     # Description of the stage.
  # documentation_version = ""     # Version of the associated API documentation.
  # region                = ""     # Region where this resource will be managed.
  # tags                  = {}     # Map of tags to assign to the resource.
  # variables             = {}     # Map that defines the stage variables.
  # xray_tracing_enabled  = false  # Whether active tracing with X-ray is enabled.
  # access_log_settings {}  # Enables access logs for the API stage.
  # canary_settings {}  # Configuration settings of a canary deployment.
}
]]></content>
<tabTrigger>aws_api_gateway_stage</tabTrigger>
<scope>source.terraform</scope>
<description>Manages an API Gateway Stage.</description>
</snippet>
