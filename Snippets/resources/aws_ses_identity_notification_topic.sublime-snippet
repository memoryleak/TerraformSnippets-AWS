<snippet>
<content><![CDATA[
resource "aws_ses_identity_notification_topic" "${1:name}" {
  identity          = "${2:identity}"           # Identity for which the Amazon SNS topic will be set.
  notification_type = "${3:notification_type}"  # Type of notifications that will be published to the specified Amazon SNS topic.

  # include_original_headers = false  # Whether SES should include original email headers in SNS notifications of this type.
  # region                   = ""     # Region where this resource will be managed.
  # topic_arn                = ""     # ARN of the Amazon SNS topic.
}
]]></content>
<tabTrigger>aws_ses_identity_notification_topic</tabTrigger>
<scope>source.terraform</scope>
<description>Setting AWS SES Identity Notification Topic</description>
</snippet>
