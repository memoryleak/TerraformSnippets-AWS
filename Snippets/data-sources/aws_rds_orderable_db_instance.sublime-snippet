data "aws_rds_orderable_db_instance" "${1:name}" {
  engine = "${2:engine}"  # DB engine.

  # availability_zone_group              = ""     # Availability zone group.
  # engine_latest_version                = false  # When set to true, the data source attempts to return the most recent version matching the other c...
  # engine_version                       = ""     # Version of the DB engine.
  # instance_class                       = ""     # DB instance class.
  # license_model                        = ""     # License model.
  # preferred_engine_versions            = []     # Ordered list of preferred RDS DB instance engine versions.
  # preferred_instance_classes           = []     # Ordered list of preferred RDS DB instance classes.
  # read_replica_capable                 = false  # Whether a DB instance can have a read replica.
  # region                               = ""     # Region where this resource will be managed.
  # storage_type                         = ""     # Storage types.
  # supported_engine_modes               = []     # Use to limit results to engine modes such as provisioned.
  # supported_network_types              = []     # Use to limit results to network types IPV4 or DUAL.
  # supports_clusters                    = false  # Whether to limit results to instances that support clusters.
  # supports_enhanced_monitoring         = false  # Enable this to ensure a DB instance supports Enhanced Monitoring at intervals from 1 to 60 seconds.
  # supports_global_databases            = false  # Enable this to ensure a DB instance supports Aurora global databases with a specific combination...
  # supports_iam_database_authentication = false  # Enable this to ensure a DB instance supports IAM database authentication.
  # supports_iops                        = false  # Enable this to ensure a DB instance supports provisioned IOPS.
  # supports_kerberos_authentication     = false  # Enable this to ensure a DB instance supports Kerberos Authentication.
  # supports_multi_az                    = false  # Whether to limit results to instances that are multi-AZ capable.
  # supports_performance_insights        = false  # Enable this to ensure a DB instance supports Performance Insights.
  # supports_storage_autoscaling         = false  # Enable this to ensure Amazon RDS can automatically scale storage for DB instances that use the sp...
  # supports_storage_encryption          = false  # Enable this to ensure a DB instance supports encrypted storage.
  # vpc                                  = false  # Boolean that indicates whether to show only VPC or non-VPC offerings.
}
]]></content>
