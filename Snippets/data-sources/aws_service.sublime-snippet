data "aws_service" "${1:name}" {
  # dns_name           = ""  # DNS name of the service (_e.g.,_ rds.us-east-1.amazonaws.com).
  # region             = ""  # Region of the service (_e.g.,_ us-west-2, ap-northeast-1).
  # reverse_dns_name   = ""  # Reverse DNS name of the service (_e.g.,_ com.amazonaws.us-west-2.s3).
  # reverse_dns_prefix = ""  # Prefix of the service (_e.g.,_ com.amazonaws in AWS Commercial, cn.com.amazonaws in AWS China).
  # service_id         = ""  # Service endpoint ID (_e.g.,_ s3, rds, ec2).
}
