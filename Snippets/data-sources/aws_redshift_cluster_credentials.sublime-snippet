<content><![CDATA[
data "aws_redshift_cluster_credentials" "${1:name}" {
  cluster_identifier = "${2:cluster_identifier}"  # Unique identifier of the cluster that contains the database for which your are requesting credent...
  db_user            = "${3:db_user}"             # Name of a database user.

  # auto_create      = false  # Create a database user with the name specified for the user named in db_user if one does not exist.
  # db_groups        = []     # List of the names of existing database groups that the user named in db_user will join for the cu...
  # db_name          = ""     # Name of a database that DbUser is authorized to log on to.
  # duration_seconds = 0      # The number of seconds until the returned temporary password expires.
  # region           = ""     # Region where this resource will be managed.
}
]]></content>
<tabTrigger>data_aws_redshift_cluster_credentials</tabTrigger>
<scope>source.terraform</scope>
<description>Data source: Provides redshift cluster credentials</description>
</snippet>
