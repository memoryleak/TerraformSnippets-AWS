data "aws_secretsmanager_secret_version" "${1:name}" {
  secret_id = "${2:secret_id}"  # Secret containing the version that you want to retrieve.

  # region        = ""  # Region where this resource will be managed.
  # version_id    = ""  # Unique identifier of the version of the secret that you want to retrieve.
  # version_stage = ""  # Secret version that you want to retrieve by the staging label attached to the version.
}
]]></content>
<tabTrigger>data_aws_secretsmanager_secret_version</tabTrigger>
<scope>source.terraform</scope>
<description>Data source: Retrieve information about a Secrets Manager secret version including its secret value</description>
