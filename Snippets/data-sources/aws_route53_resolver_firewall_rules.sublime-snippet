data "aws_route53_resolver_firewall_rules" "${1:name}" {
  firewall_rule_group_id = "${2:firewall_rule_group_id}"  # The unique identifier of the firewall rule group that you want to retrieve the rules for.

  # action   = ""  # The action that DNS Firewall should take on a DNS query when it matches one of the domains in the...
  # priority = 0   # The setting that determines the processing order of the rules in a rule group.
  # region   = ""  # Region where this resource will be managed.
}
]]></content>
