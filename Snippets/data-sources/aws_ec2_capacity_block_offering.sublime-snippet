<content><![CDATA[
data "aws_ec2_capacity_block_offering" "${1:name}" {
  capacity_duration_hours = ${2:0}                # The amount of time of the Capacity Block reservation in hours.
  instance_count          = ${3:0}                # The number of instances for which to reserve capacity.
  instance_type           = "${4:instance_type}"  # The instance type for which to reserve capacity.

  # end_date_range   = ""  # The date and time at which the Capacity Block Reservation expires.
  # region           = ""  # Region where this resource will be managed.
  # start_date_range = ""  # The date and time at which the Capacity Block Reservation starts.
}
]]></content>
<tabTrigger>data_aws_ec2_capacity_block_offering</tabTrigger>
<scope>source.terraform</scope>
<description>Data source: Information about a single EC2 Capacity Block Offering.</description>
</snippet>
